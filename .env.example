# Public origin and server
SITE_URL=https://optidigi.nl
HOST=0.0.0.0
PORT=8080

# Cloudflare Email Service
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
MAIL_FROM_ADDRESS=website@optidigi.nl
MAIL_FROM_NAME=Optidigi
MAIL_CONTACT_TO=hey@optidigi.nl

# Appointment availability (Europe/Amsterdam)
BOOKING_DATABASE_PATH=/data/optidigi.sqlite
BOOKING_TIMEZONE=Europe/Amsterdam
BOOKING_DURATION_MINUTES=30
BOOKING_INTERVAL_MINUTES=30
BOOKING_MIN_NOTICE_HOURS=24
BOOKING_HORIZON_DAYS=30
BOOKING_WORKDAYS=1,2,3,4,5
BOOKING_START_TIME=09:00
BOOKING_END_TIME=17:00

# Private management page. Use a long generated password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_EMAILS=hey@optidigi.nl
ADMIN_API_TOKEN=
OUTBOX_CRON_SECRET=
