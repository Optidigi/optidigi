---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Optidigi" } = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon-od.svg" />
    <meta name="theme-color" content="#05aa74" />
    <title>{title}</title>
  </head>
  <body class="bg-background overflow-x-hidden antialiased [--grid-size:108px] [--subgrid-size:calc(var(--grid-size)/2)]">
    <slot />
  </body>
</html>
