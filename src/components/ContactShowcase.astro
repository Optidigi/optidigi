---
import AiAgentConversation from "@/components/AiAgentConversation.astro";
import SolutionBuildVisual from "@/components/process/SolutionBuildVisual.astro";

const slides = [
  {
    label: "AI die meedenkt",
    image: "/feature-slide-1.webp",
    kind: "chat" as const,
  },
  {
    label: "Automatisering die werk overneemt",
    image: "/feature-slide-0.webp",
    kind: "automation" as const,
  },
];
---

<div class="relative h-full overflow-hidden rounded-xl" data-contact-visuals>
  {slides.map((slide, index) => (
    <article
      data-contact-slide
      data-slide-index={index}
      hidden={index !== 0}
      aria-hidden={index === 0 ? "false" : "true"}
      class:list={[
        "absolute inset-0 transition-[opacity,filter,transform] duration-500 ease-out",
        index === 0 ? "opacity-100 blur-0" : "opacity-0 blur-xs",
      ]}
    >
      <img
        src={slide.image}
        alt=""
        class="absolute inset-0 size-full object-cover opacity-65 dark:opacity-35"
        loading={index === 0 ? "eager" : "lazy"}
        width="3029"
        height="3029"
      />

      <div class="relative z-10 flex h-full items-center justify-center px-4">
        {slide.kind === "chat" ? (
          <div class="scale-85 min-w-xs w-full">
            <AiAgentConversation />
          </div>
        ) : (
          <div aria-hidden="true" class="scale-145 sm:scale-160">
            <SolutionBuildVisual />
          </div>
        )}
      </div>
      <span class="sr-only">{slide.label}</span>
    </article>
  ))}

  <div class="absolute bottom-5 left-1/2 z-20 flex -translate-x-1/2 gap-1.5 rounded-full border border-white/15 bg-black/20 p-2 backdrop-blur-md" aria-label="Illustratie kiezen">
    {slides.map((slide, index) => (
      <button
        type="button"
        data-contact-dot
        data-slide-index={index}
        aria-label={`Toon ${slide.label}`}
        aria-pressed={index === 0 ? "true" : "false"}
        class:list={[
          "h-1.5 cursor-pointer rounded-full bg-white transition-all",
          index === 0 ? "w-5" : "w-1.5 opacity-45",
        ]}
      ></button>
    ))}
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-contact-visuals]");
  const slides = Array.from(root?.querySelectorAll<HTMLElement>("[data-contact-slide]") ?? []);
  const dots = Array.from(root?.querySelectorAll<HTMLButtonElement>("[data-contact-dot]") ?? []);
  let active = 0;
  let timer: number | undefined;

  const show = (index: number) => {
    active = index;
    slides.forEach((slide, slideIndex) => {
      const selected = slideIndex === active;
      if (selected) slide.hidden = false;
      slide.setAttribute("aria-hidden", String(!selected));
      requestAnimationFrame(() => {
        slide.classList.toggle("opacity-100", selected);
        slide.classList.toggle("blur-0", selected);
        slide.classList.toggle("opacity-0", !selected);
        slide.classList.toggle("blur-xs", !selected);
      });
      if (!selected) window.setTimeout(() => { if (active !== slideIndex) slide.hidden = true; }, 500);
    });
    dots.forEach((dot, dotIndex) => {
      const selected = dotIndex === active;
      dot.setAttribute("aria-pressed", String(selected));
      dot.classList.toggle("w-5", selected);
      dot.classList.toggle("w-1.5", !selected);
      dot.classList.toggle("opacity-45", !selected);
    });
  };

  const stop = () => { if (timer) window.clearInterval(timer); };
  const start = () => { stop(); timer = window.setInterval(() => show((active + 1) % slides.length), 10000); };
  dots.forEach((dot, index) => dot.addEventListener("click", () => { show(index); start(); }));
  root?.addEventListener("mouseenter", stop);
  root?.addEventListener("mouseleave", start);
  if (slides.length > 1) start();
</script>
