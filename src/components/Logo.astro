---
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<img
  src="/optidigi-logo.svg"
  alt="Optidigi"
  width="1095"
  height="272"
  decoding="async"
  fetchpriority="high"
  class={cn("block w-auto dark:invert", className)}
/>
