---
import moneybirdLogo from "@/assets/brand-logos/moneybird.svg?url";
import type { Locale } from "@/i18n";
interface Props { locale?: Locale; }
const { locale = "nl" } = Astro.props;
---

<div
  class="mt-16 grid items-center gap-7 md:mt-20 lg:grid-cols-[12.5rem_minmax(0,1fr)] lg:gap-8"
  aria-labelledby="platform-logo-cloud-heading"
>
  <p
    id="platform-logo-cloud-heading"
    class="text-foreground mx-auto w-fit max-w-sm text-balance text-center text-sm font-medium lg:mx-0 lg:max-w-none lg:text-left lg:leading-relaxed"
  >
    <span class="lg:block">{locale === "en" ? "Leading platforms." : "Toonaangevende platforms."}</span>
    <span class="lg:block">{locale === "en" ? "Local expertise." : "Lokale expertise."}</span>
  </p>

  <div class="grid grid-cols-2 items-center gap-x-2 gap-y-8 min-[390px]:gap-x-4 lg:grid-cols-4 lg:gap-x-8">
    <div class="flex h-10 min-w-0 items-center justify-center" aria-label="Microsoft 365">
      <div class="text-foreground flex items-center gap-2 min-[390px]:gap-2.5">
        <svg aria-hidden="true" class="size-4 shrink-0 min-[390px]:size-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M0 0v11.408h11.408V0zm12.594 0v11.408H24V0zM0 12.594V24h11.408V12.594zm12.594 0V24H24V12.594z"></path>
        </svg>
        <span class="whitespace-nowrap text-xs font-semibold tracking-[-0.025em] min-[390px]:text-sm lg:text-[15px]">Microsoft 365</span>
      </div>
    </div>

    <div class="flex h-10 min-w-0 items-center justify-center" aria-label="Google Workspace">
      <div class="text-foreground flex items-center gap-2 min-[390px]:gap-2.5">
        <svg aria-hidden="true" class="size-4 shrink-0 min-[390px]:size-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09Z"></path>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23Z"></path>
          <path d="M5.84 14.09A6.3 6.3 0 0 1 5.49 12c0-.73.13-1.43.35-2.09V7.07H2.18A11 11 0 0 0 1 12c0 1.78.43 3.45 1.18 4.93l3.66-2.84Z"></path>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53Z"></path>
        </svg>
        <span class="whitespace-nowrap text-xs font-medium tracking-[-0.025em] min-[390px]:text-sm lg:text-[15px]">Google Workspace</span>
      </div>
    </div>

    <div class="flex h-10 min-w-0 items-center justify-center" aria-label="Shopify Partner">
      <div class="text-foreground flex items-center gap-2 min-[390px]:gap-2.5">
        <svg aria-hidden="true" class="size-5 shrink-0 min-[390px]:size-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="m15.337 23.979 7.216-1.561S19.949 4.805 19.928 4.688c-.018-.116-.114-.192-.211-.192s-1.929-.136-1.929-.136-1.275-1.274-1.439-1.411a.4.4 0 0 0-.121-.074l-.914 21.104h.023ZM11.71 11.305s-.81-.424-1.774-.424c-1.447 0-1.504.906-1.504 1.141 0 1.232 3.24 1.715 3.24 4.629 0 2.295-1.44 3.76-3.406 3.76-2.354 0-3.54-1.465-3.54-1.465l.646-2.086s1.245 1.066 2.28 1.066c.675 0 .975-.545.975-.932 0-1.619-2.654-1.694-2.654-4.359-.034-2.237 1.571-4.416 4.827-4.416 1.257 0 1.875.361 1.875.361l-.945 2.715-.02.01ZM11.17.83c.136 0 .271.038.405.135-.984.465-2.064 1.639-2.508 3.992-.656.213-1.293.405-1.889.578C7.697 3.75 8.951.84 11.17.84V.83Zm1.235 2.949v.135c-.754.232-1.583.484-2.394.736.466-1.777 1.333-2.645 2.085-2.971.193.501.309 1.176.309 2.1Zm.539-2.234c.694.074 1.141.867 1.429 1.755-.349.114-.735.231-1.158.366v-.252c0-.752-.096-1.371-.271-1.871v.002Zm2.992 1.289c-.02 0-.06.021-.078.021s-.289.075-.714.21c-.423-1.233-1.176-2.37-2.508-2.37h-.115C12.135.209 11.669 0 11.265 0 8.159 0 6.675 3.877 6.21 5.846c-1.194.365-2.063.636-2.16.674-.675.213-.694.232-.772.87-.075.462-1.83 14.063-1.83 14.063L15.009 24l.927-21.166Z"></path>
        </svg>
        <span class="whitespace-nowrap text-xs font-semibold tracking-[-0.025em] min-[390px]:text-sm lg:text-[15px]">Shopify Partner</span>
      </div>
    </div>

    <div class="flex h-10 min-w-0 items-center justify-center" aria-label="Moneybird">
      <img
        src={moneybirdLogo}
        alt=""
        width="980"
        height="160"
        class="h-4 w-auto dark:brightness-0 dark:invert min-[390px]:h-[1.15rem] lg:h-5"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</div>
