---
import ServiceTabIcon from "@/components/ServiceTabIcon.astro";
import AutomationOverview from "@/components/hero/AutomationOverview.astro";
import CloudSoftwarePreview from "@/components/hero/CloudSoftwarePreview.astro";
import CustomSoftwarePreview from "@/components/hero/CustomSoftwarePreview.astro";
import { automationOverviewPanel, automationOverviewPanelEn } from "@/components/hero/automation-overview-data";
import type { Locale } from "@/i18n";
interface Props { locale?: Locale; }
const { locale = "nl" } = Astro.props;

const tabPillBaseClass = "ring-border-illustration group-active:scale-99 hover:text-foreground flex h-10 items-center gap-2 rounded-full px-3 ring-1 transition-[background-color,box-shadow,color,transform] duration-150 sm:px-4 [&>svg]:size-4";
const tabPillActiveClass = `${tabPillBaseClass} bg-illustration text-foreground shadow-primary/6.5 shadow-md`;
const tabPillInactiveClass = `${tabPillBaseClass} text-muted-foreground group-hover:bg-foreground/5`;
const tabs = [
  { id: "automation", label: locale === "en" ? "AI & automation" : "AI & automatie", icon: "bot" as const },
  { id: "custom-software", label: locale === "en" ? "Custom software" : "Maatwerk", icon: "globe" as const },
  { id: "cloud-software", label: "Cloud & software", icon: "cloud" as const },
];
const defaultTabId = tabs[0].id;
---

<div data-nosnippet class="@container relative z-10 border-b pt-12 lg:pt-20" data-hero-services-preview data-default-tab={defaultTabId}>
  <div class="border-foreground/10 border-y border-dashed pb-2">
    <div class="mx-auto max-w-4xl px-6 sm:px-11">
      <div class="divide-foreground/10 relative z-20 grid grid-cols-3 items-center justify-center gap-px divide-x divide-dashed *:h-16" role="tablist" aria-label={locale === "en" ? "Examples of our services" : "Voorbeelden van onze diensten"}>
        {tabs.map((tab, index) => (
          <button type="button" role="tab" id={`service-tab-${tab.id}`} aria-label={tab.label} aria-controls={`service-panel-${tab.id}`} tabindex={index === 0 ? "0" : "-1"} data-service-tab={tab.id} aria-selected={index === 0 ? "true" : "false"} class="group flex cursor-pointer items-center justify-center px-1 sm:px-2">
            <div class={index === 0 ? tabPillActiveClass : tabPillInactiveClass}>
              <ServiceTabIcon icon={tab.icon} />
              <span class="@max-md:hidden">{tab.label}</span>
            </div>
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="relative mx-auto -mt-2 max-w-6xl max-md:mx-1 lg:px-10">
    <div data-hero-dashboard-shell class="bg-card ring-foreground/10 relative isolate overflow-hidden rounded-2xl p-1 shadow-2xl shadow-black/25 ring-1">
      <div class="bg-card dark:bg-background ring-foreground/5 aspect-3/4 overflow-hidden rounded-xl border-4 border-l-8 border-transparent shadow ring-1 sm:aspect-3/2">
        <div class="shadow-black/6.5 relative z-10 size-full overflow-hidden">
          {tabs.map((tab, index) => (
            <div role="tabpanel" id={`service-panel-${tab.id}`} aria-labelledby={`service-tab-${tab.id}`} data-service-panel={tab.id} hidden={index !== 0 ? true : undefined} class:list={["absolute inset-0 overflow-hidden bg-background transition-opacity duration-200 ease-out motion-reduce:transition-none", index === 0 ? "opacity-100" : "opacity-0"]}>
              {tab.id === "custom-software" ? <CustomSoftwarePreview locale={locale} /> : tab.id === "cloud-software" ? <CloudSoftwarePreview locale={locale} /> : <AutomationOverview panel={locale === "en" ? automationOverviewPanelEn : automationOverviewPanel} locale={locale} />}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ defaultTabId }}>
  const root = document.querySelector("[data-hero-services-preview]");
  if (root) {
    const activePillClass = "ring-border-illustration group-active:scale-99 hover:text-foreground flex h-10 items-center gap-2 rounded-full px-3 ring-1 transition-[background-color,box-shadow,color,transform] duration-150 sm:px-4 [&>svg]:size-4 bg-illustration text-foreground shadow-primary/6.5 shadow-md";
    const inactivePillClass = "ring-border-illustration text-muted-foreground group-active:scale-99 hover:text-foreground flex h-10 items-center gap-2 rounded-full px-3 ring-1 transition-[background-color,box-shadow,color,transform] duration-150 sm:px-4 [&>svg]:size-4 group-hover:bg-foreground/5";
    const buttons = root.querySelectorAll("[data-service-tab]");
    let currentTab = root.dataset.defaultTab || defaultTabId;
    let isTransitioning = false;
    const setTab = (tabId) => {
      if (tabId === currentTab || isTransitioning) return;
      isTransitioning = true;
      const currentPanel = root.querySelector(`[data-service-panel="${currentTab}"]`);
      const nextPanel = root.querySelector(`[data-service-panel="${tabId}"]`);
      buttons.forEach((button) => {
        const pill = button.querySelector("div");
        if (!pill) return;
        const active = button.dataset.serviceTab === tabId;
        pill.className = active ? activePillClass : inactivePillClass;
        button.setAttribute("aria-selected", active ? "true" : "false");
        button.setAttribute("tabindex", active ? "0" : "-1");
      });
      currentPanel?.classList.replace("opacity-100", "opacity-0");
      window.setTimeout(() => {
        currentPanel?.setAttribute("hidden", "");
        if (nextPanel) {
          nextPanel.removeAttribute("hidden");
          nextPanel.classList.replace("opacity-0", "opacity-100");
        }
        currentTab = tabId;
        window.setTimeout(() => { isTransitioning = false; }, 200);
      }, 200);
    };
    buttons.forEach((button) => button.addEventListener("click", () => {
      if (button.dataset.serviceTab) setTab(button.dataset.serviceTab);
    }));
    buttons.forEach((button, index) => button.addEventListener("keydown", (event) => {
      if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
      event.preventDefault();
      const targetIndex = event.key === "Home"
        ? 0
        : event.key === "End"
          ? buttons.length - 1
          : (index + (event.key === "ArrowRight" ? 1 : -1) + buttons.length) % buttons.length;
      const target = buttons[targetIndex];
      target?.focus();
      if (target?.dataset.serviceTab) setTab(target.dataset.serviceTab);
    }));
  }
</script>
