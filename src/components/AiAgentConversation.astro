---
import IntegrationBadgeIcon from "@/components/IntegrationBadgeIcon.astro";

const userMessage =
  "Welke offertes wachten nog op opvolging?";

const aiText =
  "Er staan 3 offertes open. Twee klanten hebben de prijsopgave bekeken; ik heb conceptmails klaargezet voor controle.";
---

<div class="ai-agent-conversation" data-ai-chat>
  <div aria-hidden="true" class="flex flex-col gap-6">
    <div>
      <div
        class="before:mask-x-from-75% before:border-foreground/10 relative before:absolute before:inset-0 before:border-y before:border-dashed"
      >
        <div class="relative mx-auto max-w-lg">
          <div
            class="max-w-3/4 bg-linear-to-b from-card/88 ring-foreground/10 inset-ring inset-ring-background/75 ml-auto w-fit rounded-t-2xl rounded-bl-2xl rounded-br to-indigo-500/17 p-3 text-sm text-indigo-950 shadow-md shadow-indigo-600/10 ring-1 selection:bg-indigo-900/10 selection:text-indigo-700 dark:text-indigo-50/65 dark:selection:text-indigo-300"
          >
            {userMessage}
          </div>
        </div>
      </div>
    </div>

    <div class="h-30">
      <div
        class="before:mask-x-from-75% before:border-foreground/10 relative before:absolute before:inset-0 before:border-y before:border-dashed"
      >
        <div class="relative mx-auto max-w-lg">
          <div data-typing class="py-2">
            <div
              class="flex h-4 items-center space-x-1 [--color-primary:var(--color-muted-foreground)]"
            >
              <div
                class="bg-primary h-1 w-1 animate-[typing_1s_infinite] rounded-full"
                style="animation-delay: 0ms"
              >
              </div>
              <div
                class="bg-primary h-1 w-1 animate-[typing_1s_infinite] rounded-full"
                style="animation-delay: 250ms"
              >
              </div>
              <div
                class="bg-primary h-1 w-1 animate-[typing_1s_infinite] rounded-full"
                style="animation-delay: 500ms"
              >
              </div>
              <span class="sr-only">Loading</span>
            </div>
          </div>

          <div data-response class="hidden">
            <div
              class="max-w-3/4 bg-linear-to-b from-card/88 ring-foreground/10 inset-ring inset-ring-background/75 w-fit rounded-t-2xl rounded-bl rounded-br-2xl to-emerald-500/17 p-3 text-sm text-emerald-950 shadow-md shadow-emerald-600/10 ring-1 selection:bg-emerald-900/10 selection:text-emerald-700 dark:text-emerald-50/65 dark:selection:text-emerald-300"
            >
              <div class="text-sm" data-response-text></div>
            </div>
          </div>
        </div>
      </div>

      <div data-pills class="mx-auto mt-2 hidden max-w-lg">
        <div class="flex flex-wrap gap-2">
          <span class="bg-muted text-muted-foreground inline-flex h-6 items-center gap-1.5 rounded-full px-2 text-xs leading-none"><IntegrationBadgeIcon brand="salesforce" class="size-3.5" />CRM</span>
          <span class="bg-muted text-muted-foreground inline-flex h-6 items-center gap-1.5 rounded-full px-2 text-xs leading-none"><IntegrationBadgeIcon brand="gmail" class="size-3.5" />Gmail</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ aiText }}>
  function startTypewriter(element, text, speed) {
    const chunkSize =
      speed < 25 ? 1 : Math.max(1, Math.round((speed - 25) / 10));
    const frameDelay = Math.max(
      1,
      Math.round(100 / Math.sqrt(Math.min(100, Math.max(1, speed)))),
    );

    let index = 0;
    let lastTime = 0;
    let frameId = 0;

    const tick = (time) => {
      if (!lastTime) {
        lastTime = time;
      }

      const elapsed = time - lastTime;
      if (elapsed < frameDelay) {
        frameId = requestAnimationFrame(tick);
        return;
      }

      lastTime = time;
      index = Math.min(index + chunkSize, text.length);
      element.textContent = text.slice(0, index);

      if (index < text.length) {
        frameId = requestAnimationFrame(tick);
      }
    };

    frameId = requestAnimationFrame(tick);

    return () => cancelAnimationFrame(frameId);
  }

  function initChat(root) {
    if (root.dataset.initialized === "true") {
      return;
    }

    root.dataset.initialized = "true";

    const typing = root.querySelector("[data-typing]");
    const response = root.querySelector("[data-response]");
    const responseText = root.querySelector("[data-response-text]");
    const pills = root.querySelector("[data-pills]");

    const startSequence = () => {
      window.setTimeout(() => {
        typing?.classList.add("hidden");
        response?.classList.remove("hidden");
        pills?.classList.remove("hidden");

        if (responseText) {
          startTypewriter(responseText, aiText, 40);
        }
      }, 400);
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries[0]?.isIntersecting) {
            return;
          }

          observer.disconnect();
          startSequence();
        },
        { threshold: 0.2 },
      );

      observer.observe(root);
      return;
    }

    startSequence();
  }

  document.querySelectorAll("[data-ai-chat]").forEach(initChat);
</script>
