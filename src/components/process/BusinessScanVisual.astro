---
import type { Locale } from "@/i18n";
interface Props { locale?: Locale; }
const { locale: _locale = "nl" } = Astro.props;
/** Document-analysis illustration for the business scan step. */
---

<div
  aria-hidden="true"
  class="bg-foreground/3 relative isolate rounded border p-2 [--border:color-mix(in_oklab,var(--color-foreground)_7.5%,transparent)] [--primary:var(--color-indigo-500)]"
>
  <span
    class="border-foreground absolute -left-px -top-px block size-2 rounded-tl border-l border-t opacity-50"
  ></span>
  <span
    class="border-foreground absolute -right-px -top-px block size-2 rounded-tr border-r border-t opacity-50"
  ></span>
  <span
    class="border-foreground absolute -bottom-px -left-px block size-2 rounded-bl border-b border-l opacity-50"
  ></span>
  <span
    class="border-foreground absolute -bottom-px -right-px block size-2 rounded-br border-b border-r opacity-50"
  ></span>

  <div class="animate-scan absolute inset-x-4 inset-y-6 z-10 mix-blend-color">
    <div
      class="bg-linear-to-b via-primary animate-hue-rotate h-8.5 absolute -inset-x-[9px] m-auto -translate-y-1/2 rounded-md from-transparent to-transparent"
    >
    </div>
  </div>
  <div class="animate-scan absolute inset-x-4 inset-y-6 z-10">
    <div class="bg-foreground absolute -inset-x-4 m-auto h-px rounded-full"></div>
    <div
      class="bg-linear-to-r to-primary absolute -inset-x-4 m-auto h-px rounded-full from-emerald-500 blur"
    ></div>
  </div>

  <div
    aria-hidden="true"
    class="bg-card ring-border-illustration shadow-black/6.5 w-20 space-y-2 rounded-md p-3 shadow-lg ring-1"
  >
    <div class="flex items-center gap-1">
      <div class="bg-border size-2.5 rounded-full"></div>
      <div class="bg-border h-[3px] w-4 rounded-full"></div>
    </div>
    <div class="space-y-1.5">
      <div class="flex items-center gap-1">
        <div class="bg-border h-[3px] w-2.5 rounded-full"></div>
        <div class="bg-border h-[3px] w-6 rounded-full"></div>
      </div>
      <div class="flex items-center gap-1">
        <div class="bg-border h-[3px] w-2.5 rounded-full"></div>
        <div class="bg-border h-[3px] w-6 rounded-full"></div>
      </div>
    </div>
    <div class="space-y-1.5">
      <div class="bg-border h-[3px] w-full rounded-full"></div>
      <div class="flex items-center gap-1">
        <div class="bg-border h-[3px] w-2/3 rounded-full"></div>
        <div class="bg-border h-[3px] w-1/3 rounded-full"></div>
      </div>
    </div>
    <div class="mt-3 space-y-1.5">
      <div class="flex items-center gap-1">
        <div class="bg-border h-[3px] w-2/3 rounded-full"></div>
        <div class="bg-border h-[3px] w-1/3 rounded-full"></div>
        <div class="bg-border h-[3px] w-1/3 rounded-full"></div>
      </div>
      <div class="bg-border h-[3px] w-full rounded-full"></div>
      <div class="flex items-center gap-1">
        <div class="bg-border h-[3px] w-2/3 rounded-full"></div>
      </div>
    </div>
  </div>
</div>
