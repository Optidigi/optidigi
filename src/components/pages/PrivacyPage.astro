---
import LegalDocumentLayout from "@/components/pages/LegalDocumentLayout.astro";
import { getSiteConfig } from "@/config/site";
import { isLocale, localePath, type Locale } from "@/i18n";
interface Props { locale?: Locale; }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : "nl");
const siteConfig = getSiteConfig(locale);
const en = locale === "en";
const privacyEmail = "privacy@optidigi.nl";
---

<LegalDocumentLayout
  locale={locale}
  title={en ? "Privacy policy" : "Privacyverklaring"}
  description={en ? "Read how Optidigi processes personal data when you contact us or book an appointment." : "Lees hoe Optidigi persoonsgegevens verwerkt bij contact en het boeken van een afspraak."}
  canonicalPath={localePath(locale, "/privacy")}
  version="1.0"
  effectiveDate={en ? "13 July 2026" : "13 juli 2026"}
>
      <div>
        <section>
          <h2>{en ? "Who processes your data?" : "Wie verwerkt je gegevens?"}</h2>
          <p>{en ? <><strong>{siteConfig.name}</strong>, registered with the Dutch Chamber of Commerce under number {siteConfig.kvk}, is responsible for processing your data. For privacy questions, email <a href={`mailto:${privacyEmail}`}>{privacyEmail}</a> or call <a href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phone}</a>.</> : <><strong>{siteConfig.name}</strong>, KvK {siteConfig.kvk}, is verantwoordelijk voor de verwerking. Vragen over privacy kun je sturen naar <a href={`mailto:${privacyEmail}`}>{privacyEmail}</a> of telefonisch stellen via <a href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phone}</a>.</>}</p>
        </section>

        <section>
          <h2>{en ? "What data do we use?" : "Welke gegevens gebruiken we?"}</h2>
          <p>{en ? "When you contact us, we process your name, email address, topic and message. When you book an appointment, we also process the selected time, call type and, when provided, your company name, phone number and notes. Technical security logs may temporarily contain an IP address and browser information." : "Als je contact opneemt verwerken we je naam, e-mailadres, onderwerp en bericht. Bij een afspraak verwerken we daarnaast het gekozen moment, gesprekstype en, als je die invult, bedrijfsnaam, telefoonnummer en opmerkingen. Technische beveiligingslogs kunnen tijdelijk een IP-adres en browserinformatie bevatten."}</p>
        </section>

        <section>
          <h2>{en ? "Why do we use this data?" : "Waarom gebruiken we deze gegevens?"}</h2>
          <ul>
            <li>{en ? "To answer your message and stay in contact with you." : "Om je bericht te beantwoorden en contact met je te onderhouden."}</li>
            <li>{en ? "To show available times, record an appointment and prevent double bookings." : "Om beschikbare momenten te tonen, een afspraak vast te leggen en dubbele boekingen te voorkomen."}</li>
            <li>{en ? "To send confirmations and necessary information about your appointment." : "Om bevestigingen en noodzakelijke informatie over je afspraak te versturen."}</li>
            <li>{en ? "To keep the website and forms secure and reliable." : "Om de website en formulieren veilig en betrouwbaar te houden."}</li>
          </ul>
          <p class="mt-3">{en ? "Processing is necessary to take steps at your request before entering into a possible agreement and for our legitimate interest in handling business communication and appointments carefully. We do not use this data for automated decision-making or unsolicited newsletters." : "De verwerking is nodig om op jouw verzoek stappen te zetten voorafgaand aan een mogelijke overeenkomst en voor ons gerechtvaardigde belang om zakelijke communicatie en afspraken zorgvuldig af te handelen. We gebruiken deze gegevens niet voor geautomatiseerde besluitvorming of ongevraagde nieuwsbrieven."}</p>
        </section>

        <section>
          <h2>{en ? "Retention periods" : "Bewaartermijnen"}</h2>
          <p>{en ? "We do not retain contact and appointment data longer than necessary. In principle, we delete it no later than 24 months after the last substantive contact or appointment. Data that becomes part of customer records may be retained longer where required by law. Technical security logs are retained for as short a period as possible." : "Contact- en afspraakgegevens bewaren we niet langer dan nodig. In beginsel verwijderen we deze uiterlijk 24 maanden na het laatste inhoudelijke contact of de afspraak. Gegevens die onderdeel worden van een klantadministratie kunnen langer worden bewaard wanneer een wettelijke bewaarplicht dat vereist. Technische beveiligingslogs worden zo kort mogelijk bewaard."}</p>
        </section>

        <section>
          <h2>{en ? "Service providers" : "Dienstverleners"}</h2>
          <p>{en ? "We use specialist providers, including Cloudflare and TransIP, for hosting, security, email delivery and receiving business email. They process only the data required for their service and are bound by their security and privacy obligations. Where processing takes place outside the European Economic Area, we use the applicable legal safeguards." : "Voor hosting, beveiliging, e-mailaflevering en het ontvangen van zakelijke e-mail gebruiken we gespecialiseerde dienstverleners, waaronder Cloudflare en TransIP. Zij verwerken alleen gegevens die voor hun dienst nodig zijn en zijn gebonden aan hun beveiligings- en privacyverplichtingen. Als verwerking buiten de Europese Economische Ruimte plaatsvindt, gebruiken we de toepasselijke wettelijke waarborgen."}</p>
        </section>

        <section>
          <h2>{en ? "Cookies and analytics" : "Cookies en statistieken"}</h2>
          <p>{en ? "The public website does not itself place advertising or tracking cookies. We use Cloudflare Web Analytics for aggregated performance and visitor statistics. According to Cloudflare, this service does not collect visitors’ personal data." : "De openbare website plaatst zelf geen advertentie- of trackingcookies. We gebruiken Cloudflare Web Analytics voor geaggregeerde prestatie- en bezoekstatistieken. Volgens Cloudflare verzamelt deze dienst geen persoonsgegevens van bezoekers."}</p>
        </section>

        <section>
          <h2>{en ? "Your rights" : "Je rechten"}</h2>
          <p>{en ? <>You may request access to, correction, deletion, restriction or transfer of your personal data, and you may object to processing. Email your request to <a href={`mailto:${privacyEmail}`}>{privacyEmail}</a>. We may ask for additional information to verify your identity. You also have the right to lodge a complaint with the <a href="https://www.autoriteitpersoonsgegevens.nl/" rel="external">Dutch Data Protection Authority</a>.</> : <>Je kunt vragen om inzage, correctie, verwijdering, beperking of overdracht van je persoonsgegevens en je kunt bezwaar maken tegen een verwerking. Mail je verzoek naar <a href={`mailto:${privacyEmail}`}>{privacyEmail}</a>. We kunnen om aanvullende informatie vragen om je identiteit te controleren. Je hebt ook het recht een klacht in te dienen bij de <a href="https://www.autoriteitpersoonsgegevens.nl/" rel="external">Autoriteit Persoonsgegevens</a>.</>}</p>
        </section>
      </div>
</LegalDocumentLayout>
