---
import LegalDocumentLayout from "@/components/pages/LegalDocumentLayout.astro";
import { getSiteConfig } from "@/config/site";
import { isLocale, localePath, type Locale } from "@/i18n";
interface Props { locale?: Locale; }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : "nl");
const siteConfig = getSiteConfig(locale);
const en = locale === "en";
const privacyEmail = "privacy@optidigi.nl";
---

<LegalDocumentLayout
  locale={locale}
  title={en ? "Privacy policy" : "Privacyverklaring"}
  description={en ? "Read how Optidigi processes personal data when you contact us, book an appointment or use our services." : "Lees hoe Optidigi persoonsgegevens verwerkt bij contact, afspraken en onze dienstverlening."}
  canonicalPath={localePath(locale, "/privacy")}
  version="1.1"
  effectiveDate={en ? "10 November 2026" : "10 november 2026"}
>
      <div>
        <p>{en ? "This privacy policy covers contact with Optidigi, appointments and our services, including advertising management and reporting." : "Deze privacyverklaring gaat over contact met Optidigi, afspraken en onze dienstverlening, waaronder advertentiebeheer en rapportage."}</p>
        <section>
          <h2>{en ? "Who processes your data?" : "Wie verwerkt je gegevens?"}</h2>
          <p>{en ? <><strong>{siteConfig.name}</strong>, registered with the Dutch Chamber of Commerce under number {siteConfig.kvk}, is responsible for processing your data. For privacy questions, email <a href={`mailto:${privacyEmail}`}>{privacyEmail}</a> or call <a href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phone}</a>.</> : <><strong>{siteConfig.name}</strong>, KvK {siteConfig.kvk}, is verantwoordelijk voor de verwerking. Vragen over privacy kun je sturen naar <a href={`mailto:${privacyEmail}`}>{privacyEmail}</a> of telefonisch stellen via <a href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phone}</a>.</>}</p>
        </section>

        <section>
          <h2>{en ? "What data do we use?" : "Welke gegevens gebruiken we?"}</h2>
          <p>{en ? "When you contact us, we process your name, email address, topic and message. When you book an appointment, we also process the selected time, call type and, when provided, your company name, phone number and notes. Technical security logs may temporarily contain an IP address and browser information." : "Als je contact opneemt verwerken we je naam, e-mailadres, onderwerp en bericht. Bij een afspraak verwerken we daarnaast het gekozen moment, gesprekstype en, als je die invult, bedrijfsnaam, telefoonnummer en opmerkingen. Technische beveiligingslogs kunnen tijdelijk een IP-adres en browserinformatie bevatten."}</p>
          <p>{en ? "For advertising services, we use data from the business and advertising accounts you give us access to. We use business contact details, account identifiers and permissions. Depending on the assignment, we also process campaign settings, product information and content from advertisements, business pages and social media accounts, including relevant interactions. We also process aggregated results to measure campaign performance. We use only the data needed for the assignment and covered by the access you grant." : "Voor advertentiediensten gebruiken we gegevens uit de bedrijfs- en advertentieaccounts waarvoor je ons toegang geeft. We gebruiken zakelijke contactgegevens, accountnummers en machtigingen. Afhankelijk van de opdracht verwerken we ook campagne-instellingen, productinformatie en inhoud van advertenties, bedrijfspagina's en zakelijke socialmedia-accounts, inclusief relevante interacties. We verwerken ook samengevoegde resultaten om campagnes te meten. We gebruiken alleen de gegevens die nodig zijn voor de opdracht en waarvoor je ons toegang hebt gegeven."}</p>
        </section>

        <section>
          <h2>{en ? "Why do we use this data?" : "Waarom gebruiken we deze gegevens?"}</h2>
          <ul>
            <li>{en ? "To answer your message and stay in contact with you." : "Om je bericht te beantwoorden en contact met je te onderhouden."}</li>
            <li>{en ? "To show available times, record an appointment and prevent double bookings." : "Om beschikbare momenten te tonen, een afspraak vast te leggen en dubbele boekingen te voorkomen."}</li>
            <li>{en ? "To send confirmations and necessary information about your appointment." : "Om bevestigingen en noodzakelijke informatie over je afspraak te versturen."}</li>
            <li>{en ? "To keep the website and forms secure and reliable." : "Om de website en formulieren veilig en betrouwbaar te houden."}</li>
            <li>{en ? "To prepare, manage and measure advertising campaigns as agreed with you, and report on the results." : "Om advertentiecampagnes volgens de afspraken met je voor te bereiden, te beheren en te meten, en over de resultaten te rapporteren."}</li>
          </ul>
          <p class="mt-3">{en ? "We process data to carry out our agreement with you or take steps at your request before entering into an agreement. We also process data for our legitimate interest in handling business communication and appointments carefully. We do not use this data for automated decision-making or unsolicited newsletters." : "We verwerken gegevens om onze overeenkomst met je uit te voeren of op jouw verzoek stappen te zetten voorafgaand aan een overeenkomst. Daarnaast verwerken we gegevens voor ons gerechtvaardigde belang om zakelijke communicatie en afspraken zorgvuldig af te handelen. We gebruiken deze gegevens niet voor geautomatiseerde besluitvorming of ongevraagde nieuwsbrieven."}</p>
        </section>

        <section>
          <h2>{en ? "Retention periods" : "Bewaartermijnen"}</h2>
          <p>{en ? "We do not retain contact and appointment data longer than necessary. In principle, we delete it no later than 24 months after the last substantive contact or appointment. Data that becomes part of customer records may be retained longer where required by law. Technical security logs are retained for as short a period as possible." : "Contact- en afspraakgegevens bewaren we niet langer dan nodig. In beginsel verwijderen we deze uiterlijk 24 maanden na het laatste inhoudelijke contact of de afspraak. Gegevens die onderdeel worden van een klantadministratie kunnen langer worden bewaard wanneer een wettelijke bewaarplicht dat vereist. Technische beveiligingslogs worden zo kort mogelijk bewaard."}</p>
          <p>{en ? "We retain data, exports and reports from advertising assignments for as long as needed for the assignment, a legitimate business purpose or applicable obligations. We review this data and delete it manually when there is no longer a reason to retain it. Revoking access to an account stops further access through that connection. It does not automatically delete previously saved data. You can ask us to delete that data." : "Gegevens, exports en rapporten uit advertentieopdrachten bewaren we zolang ze nodig zijn voor de opdracht, een gerechtvaardigd bedrijfsdoel of geldende verplichtingen. We beoordelen deze gegevens en verwijderen ze handmatig wanneer er geen reden meer is om ze te bewaren. Als je de toegang tot een account intrekt, stopt verdere toegang via die verbinding. Eerder opgeslagen gegevens verdwijnen daardoor niet automatisch. Je kunt ons vragen deze te verwijderen."}</p>
        </section>

        <section>
          <h2>{en ? "Service providers" : "Dienstverleners"}</h2>
          <p>{en ? "We use specialist providers, including Cloudflare and TransIP, for hosting, security, email delivery and receiving business email. They process only the data required for their service and are bound by their security and privacy obligations. Where processing takes place outside the European Economic Area, we use the applicable legal safeguards." : "Voor hosting, beveiliging, e-mailaflevering en het ontvangen van zakelijke e-mail gebruiken we gespecialiseerde dienstverleners, waaronder Cloudflare en TransIP. Zij verwerken alleen gegevens die voor hun dienst nodig zijn en zijn gebonden aan hun beveiligings- en privacyverplichtingen. Als verwerking buiten de Europese Economische Ruimte plaatsvindt, gebruiken we de toepasselijke wettelijke waarborgen."}</p>
          <p>{en ? "For advertising services, we work with advertising platforms such as Meta. Authorised staff and providers that support analysis, reporting and campaign work process the relevant data. This includes providers of AI services when we use them for the assignment. We share only the data needed for that work." : "Voor advertentiediensten werken we met advertentieplatforms zoals Meta. Bevoegde medewerkers en dienstverleners die ons ondersteunen bij analyse, rapportage en campagnewerk verwerken de relevante gegevens. Daaronder vallen aanbieders van AI-diensten wanneer we die voor de opdracht inzetten. We delen alleen de gegevens die voor dat werk nodig zijn."}</p>
        </section>

        <section>
          <h2>{en ? "Cookies and analytics" : "Cookies en statistieken"}</h2>
          <p>{en ? "The public website does not itself place advertising or tracking cookies. We use Cloudflare Web Analytics for aggregated performance and visitor statistics. According to Cloudflare, this service does not collect visitors’ personal data." : "De openbare website plaatst zelf geen advertentie- of trackingcookies. We gebruiken Cloudflare Web Analytics voor geaggregeerde prestatie- en bezoekstatistieken. Volgens Cloudflare verzamelt deze dienst geen persoonsgegevens van bezoekers."}</p>
        </section>

        <section id="verwijdering" class="scroll-mt-24">
          <h2>{en ? "Your rights and data deletion" : "Je rechten en gegevens verwijderen"}</h2>
          <p>{en ? <>You may request access to, correction, deletion, restriction or transfer of your personal data, and you may object to processing. Email your request to <a href={`mailto:${privacyEmail}`}>{privacyEmail}</a>. We may ask for additional information to verify your identity. You also have the right to lodge a complaint with the <a href="https://www.autoriteitpersoonsgegevens.nl/" rel="external">Dutch Data Protection Authority</a>.</> : <>Je kunt vragen om inzage, correctie, verwijdering, beperking of overdracht van je persoonsgegevens en je kunt bezwaar maken tegen een verwerking. Mail je verzoek naar <a href={`mailto:${privacyEmail}`}>{privacyEmail}</a>. We kunnen om aanvullende informatie vragen om je identiteit te controleren. Je hebt ook het recht een klacht in te dienen bij de <a href="https://www.autoriteitpersoonsgegevens.nl/" rel="external">Autoriteit Persoonsgegevens</a>.</>}</p>
          <p>{en ? "For a deletion request, tell us which organisation or account and which data your request concerns. You can also contact us through your usual business contact at Optidigi. We check your identity and, for business requests, whether you are authorised to act for the organisation. Do not send passwords or access tokens. We handle deletion requests manually and, where needed, coordinate with the providers involved. If we need to retain any data, we explain which data and why." : "Vermeld bij een verwijderverzoek om welke organisatie of welk account en welke gegevens het gaat. Je kunt ook terecht bij je vaste zakelijke contactpersoon bij Optidigi. We controleren je identiteit en bij zakelijke verzoeken of je namens de organisatie mag handelen. Stuur geen wachtwoorden of toegangscodes mee. We handelen verwijderverzoeken handmatig af en stemmen waar nodig af met de betrokken dienstverleners. Als we gegevens moeten bewaren, leggen we uit om welke gegevens het gaat en waarom."}</p>
        </section>
      </div>
</LegalDocumentLayout>
