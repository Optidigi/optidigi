---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { isLocale, localePath, type Locale } from "@/i18n";
interface Props { locale?: Locale; }
const locale: Locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : "nl");
const en = locale === "en";
---

<Layout
  locale={locale}
  title={en ? "Page not found | Optidigi" : "Pagina niet gevonden | Optidigi"}
  description={en ? "This page does not exist or has moved." : "Deze pagina bestaat niet of is verplaatst."}
  canonicalPath={localePath(locale, "/404")}
  noindex
>
  <div class="theme-green scheme-light selection:bg-primary/15 selection:text-foreground bg-background dark:scheme-dark">
    <SiteHeader locale={locale} />
    <main id="main-content" class="mx-auto flex min-h-[70vh] max-w-5xl items-center px-6 pb-20 pt-32 lg:pt-40">
      <section class="max-w-2xl text-balance" aria-labelledby="not-found-title">
        <p class="text-primary text-sm font-medium">404</p>
        <h1 id="not-found-title" class="text-foreground mt-3 text-4xl font-semibold sm:text-5xl">
          {en ? "We couldn’t find this page" : "Deze pagina konden we niet vinden"}
        </h1>
        <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
          {en ? "The page may have moved, or the link may no longer exist." : "Mogelijk is de pagina verplaatst of bestaat de link niet meer."}
        </p>
        <a
          href={localePath(locale, "/")}
          class="brand-primary-action mt-8 inline-flex h-10 items-center justify-center rounded-md border-[0.5px] border-white/10 bg-primary px-5 text-sm font-medium text-primary-foreground shadow-md shadow-black/15 ring-1 ring-black/10 transition hover:bg-primary/90 active:scale-98"
        >
          {en ? "Back to the homepage" : "Terug naar de homepage"}
        </a>
      </section>
    </main>
    <SiteFooter showLead={false} compact locale={locale} />
  </div>
</Layout>
