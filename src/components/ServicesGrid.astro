---
import WorkflowSuccessVisual from "@/components/WorkflowSuccessVisual.astro";
import AiTaskPlanningVisual from "@/components/AiTaskPlanningVisual.astro";
import SoftwareStackGrid from "@/components/SoftwareStackGrid";
import CustomerSystemsVisual from "@/components/CustomerSystemsVisual.astro";

const cardShell =
  "ring-border bg-card text-card-foreground shadow-black/6.5 shadow ring-1 overflow-hidden rounded-2xl p-8";
const cardGrid = "grid grid-rows-[auto_1fr] gap-6";
const cardSubtitle = "text-muted-foreground mt-3 text-balance";
const illustrationSlot = "relative -mx-4 min-h-0 px-4 pt-4";
const maskedIllustrationSlotBase = [
  "mask-b-from-65% before:border-border after:border-border before:z-1 group",
  "relative -mx-4 min-h-0 min-w-0 overflow-hidden px-4 pt-6",
  "before:absolute before:inset-x-6 before:bottom-0 before:top-4 before:rounded-2xl before:border",
  "after:absolute after:bottom-0 after:top-2 after:rounded-2xl after:border",
].join(" ");
---

<section id="diensten" class="@container bg-background py-24" data-services-grid>
  <h2 class="sr-only">Features</h2>
  <div class="mx-auto w-full max-w-5xl px-6">
    <div class="@xl:grid-cols-2 @3xl:grid-cols-6 grid gap-3">
      <div data-slot="card" class:list={[cardShell, cardGrid, "@xl:col-span-full @3xl:col-span-2 group"]}>
        <div>
          <h3 class="text-foreground font-semibold">Automatische workflows</h3>
          <p class={cardSubtitle}>
            Zet terugkerende stappen om in workflows die slim automatisch worden afgehandeld.
          </p>
        </div>
        <div aria-hidden="true" class:list={[illustrationSlot, "pb-2"]}>
          <WorkflowSuccessVisual />
        </div>
      </div>

      <div
        data-slot="card"
        class:list={[cardShell, cardGrid, "@xl:col-span-full @3xl:col-span-4 min-w-0"]}
      >
        <div>
          <h3 class="text-foreground font-semibold">Zet AI aan het werk</h3>
          <p class={cardSubtitle}>
            Ontlast je team met AI die werk begrijpt, relevante context verzamelt en acties
            uitvoert in je systemen.
          </p>
        </div>
        <div
          aria-hidden="true"
          class:list={[
            maskedIllustrationSlotBase,
            "before:bg-background after:bg-background/50 after:inset-x-9",
          ]}
        >
          <AiTaskPlanningVisual />
        </div>
      </div>

      <div
        data-slot="card"
        class:list={[cardShell, cardGrid, "@xl:col-span-full @3xl:col-span-3"]}
      >
        <div>
          <h3 class="text-foreground font-semibold">Klantgerichte systemen</h3>
          <p class={cardSubtitle}>
            Websites, webshops en portalen waar klanten kopen, inloggen, bestellen, uploaden of
            zelf zaken regelen.
          </p>
        </div>
        <div
          aria-hidden="true"
          class:list={[
            maskedIllustrationSlotBase,
            "before:bg-card after:bg-background after:inset-x-8",
          ]}
        >
          <CustomerSystemsVisual />
        </div>
      </div>

      <div
        data-slot="card"
        class:list={[cardShell, cardGrid, "@xl:col-span-full @3xl:col-span-3"]}
      >
        <div>
          <h3 class="text-foreground font-semibold">Software die past</h3>
          <p class={cardSubtitle}>
            Wij richten de programma’s en systemen in waarmee je team veiliger, sneller en
            efficiënter werkt.
          </p>
        </div>
        <div
          aria-hidden="true"
          class="brand-software-card-atmosphere bg-linear-to-b border-background relative -m-8 flex flex-col justify-center border-x from-transparent via-orange-400/5 to-zinc-400/5 p-8"
        >
          <div
            aria-hidden="true"
            class="absolute -inset-x-6 inset-y-0 bg-[repeating-linear-gradient(-45deg,black,black_1px,transparent_1px,transparent_6px)] mix-blend-overlay [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_70%,transparent_100%)]"
          >
          </div>
          <div class="relative">
            <SoftwareStackGrid client:visible />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
