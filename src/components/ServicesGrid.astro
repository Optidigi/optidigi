---
import WorkflowSuccessVisual from "@/components/WorkflowSuccessVisual.astro";
import AiTaskPlanningVisual from "@/components/AiTaskPlanningVisual.astro";
import SoftwareStackGrid from "@/components/SoftwareStackGrid";
import CustomerSystemsVisual from "@/components/CustomerSystemsVisual.astro";
import PlatformLogoCloud from "@/components/PlatformLogoCloud.astro";
import type { Locale } from "@/i18n";
interface Props { locale?: Locale; }
const { locale = "nl" } = Astro.props;
const copy = locale === "en" ? {
  headingMuted: "Digital systems ", headingStrong: "built around the way your business works",
  intro1a: "We help your business move forward with ", automation: "automation", intro1b: " that removes recurring work and ", ai: "AI", intro1c: " that supports your team, leaving more time for what really matters.",
  intro2a: "From ", sites: "websites and portals", intro2b: " to the ", software: "software that fits", intro2c: " your team: we connect, implement and configure everything so processes run smoothly and customers are well served.",
  cards: [
    ["Automated workflows", "Turn recurring steps into intelligent workflows that run automatically."],
    ["Put AI to work", "Support your team with AI that understands the task, gathers the right context and takes action across your systems."],
    ["Customer-facing systems", "Websites, online stores and portals where customers can buy, sign in, order, upload or manage things themselves."],
    ["Software that fits", "We configure the tools and systems your team needs to work more securely, quickly and efficiently."],
  ],
} : {
  headingMuted: "Optimale processen en digitale systemen ", headingStrong: "voor bedrijven die de volgende stap willen zetten",
  intro1a: "Wij helpen je bedrijf vooruit met ", automation: "automatisering", intro1b: " die terugkerend werk wegneemt en ", ai: "AI", intro1c: " die je team ontlast, zodat er meer tijd overblijft voor wat echt telt.",
  intro2a: "Van ", sites: "websites en portalen", intro2b: " tot de ", software: "software die past", intro2c: " bij je team: wij koppelen, implementeren en richten alles in zodat processen soepel lopen en klanten goed bediend worden.",
  cards: [
    ["Automatische workflows", "Zet terugkerende stappen om in workflows die slim automatisch worden afgehandeld."],
    ["Zet AI aan het werk", "Ontlast je team met AI die werk begrijpt, relevante context verzamelt en acties uitvoert in je systemen."],
    ["Klantgerichte systemen", "Websites, webshops en portalen waar klanten kopen, inloggen, bestellen, uploaden of zelf zaken regelen."],
    ["Software die past", "Wij richten de programma’s en systemen in waarmee je team veiliger, sneller en efficiënter werkt."],
  ],
};

const cardShell =
  "ring-border bg-card text-card-foreground shadow-black/6.5 shadow ring-1 overflow-hidden rounded-2xl p-8";
const cardGrid = "grid grid-rows-[auto_1fr] gap-6";
const cardSubtitle = "text-muted-foreground mt-3 text-balance";
const illustrationSlot = "relative -mx-4 min-h-0 px-4 pt-4";
const maskedIllustrationSlotBase = [
  "mask-b-from-65% group",
  "relative -mx-4 flex min-h-0 min-w-0 flex-col justify-end overflow-hidden px-4 pt-6",
].join(" ");

const illustrationStackBase = [
  "relative",
  "before:border-border after:border-border",
  "before:absolute before:inset-x-2 before:-top-2 before:bottom-0 before:z-1 before:rounded-2xl before:border",
  "after:absolute after:-top-4 after:bottom-0 after:rounded-2xl after:border",
].join(" ");
---

<section
  id={locale === "en" ? "services" : "diensten"}
  aria-labelledby="services-heading"
  class="@container bg-background relative isolate overflow-hidden py-24 md:py-32"
  data-services-grid
>
  <div class="relative z-10 mx-auto w-full max-w-5xl px-6">
    <header class="mb-12 grid gap-6 md:mb-16 md:grid-cols-2 md:gap-12 lg:gap-20">
      <h2 id="services-heading" class="text-muted-foreground text-3xl font-semibold sm:text-4xl">
        {locale === "en" ? (
          <>
            <span class="block">Digital systems</span>
            <strong class="text-foreground block font-semibold">
              <span class="block">built around the way</span>
              <span class="block">your business works</span>
            </strong>
          </>
        ) : (
          <>
            {copy.headingMuted}
            <strong class="text-foreground font-semibold">{copy.headingStrong}</strong>
          </>
        )}
      </h2>
      <div class="space-y-5">
        <p class="text-muted-foreground text-balance text-lg leading-relaxed">
          {copy.intro1a}<strong class="text-foreground font-semibold">{copy.automation}</strong>{copy.intro1b}<strong class="text-foreground font-semibold">{copy.ai}</strong>{copy.intro1c}
        </p>
        <p class="text-muted-foreground text-balance text-lg leading-relaxed">
          {copy.intro2a}<strong class="text-foreground font-semibold">{copy.sites}</strong>{copy.intro2b}<strong class="text-foreground font-semibold">{copy.software}</strong>{copy.intro2c}
        </p>
      </div>
    </header>

    <div class="@xl:grid-cols-2 @3xl:grid-cols-6 grid gap-3">
      <div data-slot="card" class:list={[cardShell, cardGrid, "@xl:col-span-full @3xl:col-span-2 group"]}>
        <div>
          <h3 class="text-foreground font-semibold">{copy.cards[0][0]}</h3>
          <p class={cardSubtitle}>{copy.cards[0][1]}</p>
        </div>
        <div data-nosnippet aria-hidden="true" class:list={[illustrationSlot, "pb-2"]}>
          <WorkflowSuccessVisual locale={locale} />
        </div>
      </div>

      <div
        data-slot="card"
        class:list={[cardShell, cardGrid, "@xl:col-span-full @3xl:col-span-4 min-w-0"]}
      >
        <div>
          <h3 class="text-foreground font-semibold">{copy.cards[1][0]}</h3>
          <p class={cardSubtitle}>{copy.cards[1][1]}</p>
        </div>
        <div
          data-nosnippet
          aria-hidden="true"
          data-illustration-stack
          class:list={[
            maskedIllustrationSlotBase,
            "before:bg-background after:bg-background/50 after:inset-x-9",
          ]}
        >
          <div
            data-illustration-stack-frames
            class:list={[
              illustrationStackBase,
              "before:bg-background after:inset-x-5 after:bg-background/50",
            ]}
          >
            <AiTaskPlanningVisual locale={locale} />
          </div>
        </div>
      </div>

      <div
        data-slot="card"
        class:list={[cardShell, cardGrid, "@xl:col-span-full @3xl:col-span-3"]}
      >
        <div>
          <h3 class="text-foreground font-semibold">{copy.cards[2][0]}</h3>
          <p class={cardSubtitle}>{copy.cards[2][1]}</p>
        </div>
        <div
          data-nosnippet
          aria-hidden="true"
          data-illustration-stack
          class:list={[
            maskedIllustrationSlotBase,
            "before:bg-card after:bg-background after:inset-x-8",
          ]}
        >
          <div
            data-illustration-stack-frames
            class:list={[
              illustrationStackBase,
              "before:bg-card after:inset-x-4 after:bg-background",
            ]}
          >
            <CustomerSystemsVisual locale={locale} />
          </div>
        </div>
      </div>

      <div
        data-slot="card"
        data-bento-accent
        class:list={[cardShell, cardGrid, "@xl:col-span-full @3xl:col-span-3"]}
      >
        <div>
          <h3 class="text-foreground font-semibold">{copy.cards[3][0]}</h3>
          <p class={cardSubtitle}>{copy.cards[3][1]}</p>
        </div>
        <div
          data-nosnippet
          aria-hidden="true"
          class="brand-software-card-atmosphere bg-linear-to-b border-background relative -m-8 flex flex-col justify-center border-x from-transparent via-orange-400/5 to-zinc-400/5 p-8"
        >
          <div
            aria-hidden="true"
            data-software-card-pattern
            class="absolute -inset-x-6 inset-y-0 [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_70%,transparent_100%)]"
          >
          </div>
          <div class="relative">
            <SoftwareStackGrid client:visible locale={locale} />
          </div>
        </div>
      </div>
    </div>

    <PlatformLogoCloud locale={locale} />
  </div>
</section>
