---
import { getSiteConfig } from "@/config/site";
import { sharedCopy, type Locale } from "@/i18n";

interface Props {
  href?: string;
  label?: string;
  align?: "start" | "center";
  class?: string;
  locale?: Locale;
}

const {
  locale = "nl",
  href,
  label,
  align = "start",
  class: className = "",
} = Astro.props;
const siteConfig = getSiteConfig(locale);
const resolvedHref = href ?? siteConfig.ctaHref;
const resolvedLabel = label ?? sharedCopy[locale].scanCta;

const alignClass = align === "center" ? "items-center" : "items-start";
const microcopyClass = align === "center" ? "justify-center" : "";
const primaryButtonClass =
  "cursor-pointer inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-[background-color,border-color,box-shadow,transform] focus-visible:outline-none active:scale-98 focus-visible:ring-1 focus-visible:ring-ring shadow-md border-[0.5px] border-white/10 shadow-black/15 text-shadow-sm bg-primary ring-1 ring-(--ring-color) [--ring-color:color-mix(in_oklab,black_15%,var(--color-primary))] dark:border-transparent dark:[--ring-color:color-mix(in_oklab,white_15%,var(--color-primary))] text-primary-foreground hover:bg-primary/90 h-10 px-5 py-2";
---

<div class:list={["flex flex-col gap-2.5", alignClass, className]}>
  <a href={resolvedHref} data-booking-trigger class:list={[primaryButtonClass, "brand-primary-action"]}>
    {resolvedLabel}
  </a>
  <p
    class:list={[
      "text-muted-foreground flex flex-wrap items-center gap-x-3 gap-y-1 text-xs leading-snug",
      microcopyClass,
    ]}
  >
    <span class="inline-flex items-center gap-1.5">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-circle-check size-3.5 opacity-80"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="m9 12 2 2 4-4"></path>
      </svg>
      {sharedCopy[locale].noObligation}
    </span>
    <span class="bg-border hidden h-3 w-px sm:block" aria-hidden="true"></span>
    <span class="inline-flex items-center gap-1.5">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-clock size-3.5 opacity-80"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 6v6l4 2"></path>
      </svg>
      {sharedCopy[locale].duration}
    </span>
  </p>
</div>
