---
import microsoftOfficeLogo from "@/assets/brand-logos/microsoft-office.svg?url";
import microsoftDefenderLogo from "@/assets/brand-logos/microsoft-defender.svg?url";
import googleWorkspaceLogo from "@/assets/brand-logos/google-workspace.svg?url";

const setupItems = [
  { label: "Microsoft 365", detail: "12 accounts ingericht", logo: microsoftOfficeLogo, tone: "emerald" },
  { label: "Beveiliging", detail: "MFA staat aan", logo: microsoftDefenderLogo, tone: "sky" },
  { label: "Google Workspace", detail: "Bestanden overgezet", logo: googleWorkspaceLogo, tone: "violet" },
];
---

<div class="bg-background size-full overflow-hidden" aria-hidden="true">
  <div class="flex h-13 items-center gap-3 border-b border-border-illustration px-4 sm:px-5">
    <div class="flex size-7 items-center justify-center rounded-lg bg-[var(--brand-action)]/10 text-[var(--brand-action)]">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" /></svg>
    </div>
    <div>
      <div class="text-foreground text-sm font-medium">Digitale werkplek</div>
      <div class="text-muted-foreground text-[10px]">Implementatieoverzicht</div>
    </div>
    <div class="ml-auto rounded-full bg-[var(--brand-action)]/10 px-2.5 py-1 text-[10px] font-medium text-[var(--brand-action)]">4 van 5 klaar</div>
  </div>

  <div class="grid h-[calc(100%-3.25rem)] min-h-0 lg:grid-cols-[1.05fr_.95fr]">
    <section class="min-h-0 p-4 sm:p-5">
      <div class="text-muted-foreground text-xs font-medium">Werkplek klaarzetten</div>
      <div class="text-foreground mt-1 text-lg font-semibold tracking-tight">De basis staat goed voor je team</div>
      <div class="text-muted-foreground mt-1 text-xs">Software, toegang en beveiliging worden in één keer goed ingericht.</div>

      <div class="mt-4 space-y-2">
        {setupItems.map((item) => (
          <div class="bg-illustration ring-border-illustration flex items-center gap-3 rounded-xl p-3 shadow-sm ring-1">
            <div class:list={["flex size-9 shrink-0 items-center justify-center rounded-lg", item.tone === "emerald" ? "bg-emerald-500/10" : item.tone === "sky" ? "bg-sky-500/10" : "bg-violet-500/10"]}>
              <img src={item.logo} alt="" width="24" height="24" class="size-5" decoding="async" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-foreground text-sm font-medium">{item.label}</div>
              <div class="text-muted-foreground mt-0.5 text-[11px]">{item.detail}</div>
            </div>
            <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3"><path d="m5 12 4 4L19 6" /></svg>
            </div>
          </div>
        ))}
      </div>

      <div class="ring-border-illustration mt-3 flex items-center gap-3 rounded-xl p-3 ring-1">
        <div class="flex size-8 items-center justify-center rounded-lg bg-amber-500/10 text-amber-600">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M12 2v20" /><path d="M2 12h20" /></svg>
        </div>
        <div>
          <div class="text-foreground text-xs font-medium">Volgende stap</div>
          <div class="text-muted-foreground mt-0.5 text-[10px]">Teams en gedeelde mappen klaarzetten</div>
        </div>
      </div>
    </section>

    <aside class="max-lg:hidden relative overflow-hidden border-l border-border-illustration p-5">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(var(--color-foreground)_1px,transparent_1px)] opacity-[0.06] [background-size:13px_13px]"></div>
      <div class="absolute inset-0 bg-linear-to-b from-background/10 via-transparent to-background/70"></div>
      <div class="relative mx-auto max-w-xs">
        <div class="text-muted-foreground text-xs font-medium">Nieuwe collega</div>
        <div class="text-foreground mt-1 text-base font-semibold">Toegang in één keer geregeld</div>

        <div class="bg-card/95 ring-border-illustration mt-5 rounded-2xl p-4 shadow-xl shadow-black/8 ring-1 backdrop-blur">
          <div class="flex items-center gap-3">
            <div class="flex size-10 items-center justify-center rounded-full bg-[var(--brand-action)]/12 text-[var(--brand-action)]">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5"><rect width="16" height="12" x="4" y="8" rx="3"/><path d="M9 12h.01M15 12h.01M8 16h8M9 8V5a3 3 0 0 1 6 0v3"/></svg>
            </div>
            <div>
              <div class="text-foreground text-sm font-medium">Jesse Visser</div>
              <div class="text-muted-foreground text-[11px]">jesse@mijnbedrijf.nl</div>
            </div>
          </div>
          <div class="mt-4 border-t border-border-illustration pt-3">
            <div class="text-muted-foreground text-[10px] font-medium">TOEGANG</div>
            <div class="mt-2 flex flex-wrap gap-1.5">
              <span class="rounded-md bg-illustration px-2 py-1 text-[10px] text-foreground/75 ring-1 ring-border-illustration">E-mail</span>
              <span class="rounded-md bg-illustration px-2 py-1 text-[10px] text-foreground/75 ring-1 ring-border-illustration">Teams</span>
              <span class="rounded-md bg-illustration px-2 py-1 text-[10px] text-foreground/75 ring-1 ring-border-illustration">Bestanden</span>
            </div>
          </div>
          <div class="mt-4 flex items-center gap-2 rounded-lg bg-emerald-500/10 px-2.5 py-2 text-[11px] font-medium text-emerald-700 dark:text-emerald-400"><span class="size-1.5 rounded-full bg-emerald-500"></span>Klaar om te starten</div>
        </div>
      </div>
    </aside>
  </div>
</div>
