---
import type { Locale } from "@/i18n";
interface Props { locale?: Locale; }
const { locale = "nl" } = Astro.props;
const categories = locale === "en" ? ["Products", "My order lists", "Orders", "Invoices"] : ["Assortiment", "Mijn bestellijsten", "Bestellingen", "Facturen"];
const products = [
  { code: "AP-104", name: locale === "en" ? "Cloudy apple juice" : "Appelsap troebel", detail: "12 × 0.75 L", price: "€ 28.40", quantity: 2 },
  { code: "KA-220", name: locale === "en" ? "Organic buttermilk" : "Karnemelk biologisch", detail: "6 × 1 L", price: "€ 14.10", quantity: 1 },
  { code: "YO-315", name: locale === "en" ? "Natural farmhouse yoghurt" : "Boerenyoghurt naturel", detail: "6 × 500 ml", price: "€ 18.75", quantity: 0 },
];
---

<div class="bg-background size-full overflow-hidden" aria-hidden="true">
  <!-- Browser chrome: the portal is intentionally shown as a real web product. -->
  <div class="flex h-11 items-center gap-3 border-b border-border-illustration bg-illustration/25 px-3.5 sm:px-5">
    <div class="hidden items-center gap-1.5 sm:flex">
      <span class="bg-foreground/14 size-2 rounded-full"></span>
      <span class="bg-foreground/14 size-2 rounded-full"></span>
      <span class="bg-foreground/14 size-2 rounded-full"></span>
    </div>
    <div class="bg-background text-muted-foreground ring-border-illustration mx-auto flex h-7 w-full max-w-md items-center gap-2 rounded-md px-2.5 text-[9px] ring-1">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3 opacity-55"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <span class="truncate">{locale === "en" ? "orders.vermeerhospitality.com" : "bestellen.vermeerhoreca.nl"}</span>
    </div>
    <div class="text-muted-foreground hidden text-[9px] sm:block">•••</div>
  </div>

  <div class="flex h-[calc(100%-2.75rem)] min-h-0 flex-col">
    <header class="flex h-14 shrink-0 items-center border-b border-border-illustration px-4 sm:px-5 lg:px-6">
      <div class="flex items-center gap-2.5">
        <div class="flex size-8 items-center justify-center rounded-md bg-[#183e32] text-[10px] font-bold tracking-wide text-white">VH</div>
        <div class="max-sm:hidden">
          <div class="text-foreground text-[11px] font-semibold">Vermeer Horeca</div>
          <div class="text-muted-foreground text-[8px]">{locale === "en" ? "Order portal" : "Bestelportaal"}</div>
        </div>
      </div>
      <div class="bg-illustration/60 text-muted-foreground ml-5 hidden h-8 w-full max-w-xs items-center gap-2 rounded-md px-3 text-[9px] ring-1 ring-border-illustration sm:flex">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-3.5 opacity-60"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        Zoek op product of artikelnummer
      </div>
      <div class="ml-auto flex items-center gap-3">
        <div class="text-muted-foreground hidden text-right text-[8px] sm:block"><div class="text-foreground text-[10px] font-medium">Bistro North</div>{locale === "en" ? "Customer 3842" : "Klantnummer 3842"}</div>
        <div class="flex size-8 items-center justify-center rounded-full bg-[var(--brand-action)]/12 text-[9px] font-semibold text-[var(--brand-action)]">SN</div>
      </div>
    </header>

    <div class="grid min-h-0 flex-1 md:grid-cols-[10.5rem_minmax(0,1fr)]">
      <aside class="hidden min-h-0 border-r border-border-illustration bg-illustration/20 px-3 py-4 md:flex md:flex-col">
        <div class="text-muted-foreground px-2 text-[8px] font-semibold uppercase tracking-[0.14em]">{locale === "en" ? "Ordering" : "Bestellen"}</div>
        <nav class="mt-2 space-y-1">
          {categories.map((item, index) => (
            <div class:list={["flex h-8 items-center gap-2.5 rounded-md px-2.5 text-[10px] font-medium", index === 0 ? "bg-card text-foreground shadow-sm ring-1 ring-border-illustration" : "text-muted-foreground"]}>
              {index === 0 ? <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3.5"><path d="M4 7h16M4 12h16M4 17h10"/></svg> : index === 1 ? <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3.5"><path d="M3 5h18v14H3z"/><path d="M8 9h8M8 13h5"/></svg> : index === 2 ? <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3.5"><path d="M6 2 3 6v14h18V6l-3-4Z"/><path d="M3 6h18M9 10a3 3 0 0 0 6 0"/></svg> : <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3.5"><path d="M14 2H6a2 2 0 0 0-2 2v16h16V8Z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>}
              {item}
            </div>
          ))}
        </nav>
        <div class="text-muted-foreground mt-auto border-t border-border-illustration px-2 pt-3 text-[8px] leading-relaxed">{locale === "en" ? "Need help?" : "Hulp nodig?"}<br/><span class="text-foreground font-medium">{locale === "en" ? "Contact us" : "Neem contact op"}</span></div>
      </aside>

      <div class="min-w-0 overflow-hidden px-4 py-4 sm:px-5 lg:px-6">
        <div class="flex items-end justify-between gap-4">
          <div>
            <div class="text-foreground text-base font-semibold tracking-tight sm:text-lg">{locale === "en" ? "Products" : "Assortiment"}</div>
            <div class="text-muted-foreground mt-0.5 text-[9px] sm:text-[10px]">{locale === "en" ? "Regular products for Bistro North" : "Vaste producten voor Bistro Noord"}</div>
          </div>
          <div class="text-muted-foreground hidden items-center gap-1.5 text-[9px] sm:flex"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3.5"><path d="M3 6h18M6 12h12M10 18h4"/></svg>{locale === "en" ? "Filter" : "Filter"}</div>
        </div>

        <div class="mt-4 grid min-h-0 gap-4 lg:grid-cols-[minmax(0,1fr)_13.5rem]">
          <section class="min-w-0 overflow-hidden rounded-lg border border-border-illustration bg-card">
            <div class="grid grid-cols-[1fr_auto] border-b border-border-illustration bg-illustration/25 px-3.5 py-2.5 text-[8px] font-semibold uppercase tracking-wider text-muted-foreground sm:px-4">
              <span>Product</span><span class="pr-1">{locale === "en" ? "Quantity" : "Aantal"}</span>
            </div>
            <div class="divide-y divide-border-illustration">
              {products.map((product, index) => (
                <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3 px-3.5 py-3 sm:px-4">
                  <div class="flex min-w-0 items-center gap-3">
                    <div class:list={["flex size-9 shrink-0 items-center justify-center rounded-md text-[9px] font-semibold", index === 0 ? "bg-amber-500/10 text-amber-700 dark:text-amber-400" : index === 1 ? "bg-sky-500/10 text-sky-700 dark:text-sky-400" : "bg-violet-500/10 text-violet-700 dark:text-violet-400"]}>{product.code.slice(0, 2)}</div>
                    <div class="min-w-0"><div class="text-foreground truncate text-[10px] font-medium sm:text-[11px]">{product.name}</div><div class="text-muted-foreground mt-0.5 flex gap-2 text-[8px] sm:text-[9px]"><span>{product.detail}</span><span class="max-sm:hidden">{product.price}</span></div></div>
                  </div>
                  <div class="flex h-7 items-center rounded-md border border-border-illustration bg-background">
                    <span class="text-muted-foreground flex size-7 items-center justify-center text-xs">−</span><span class:list={["flex h-full w-7 items-center justify-center border-x border-border-illustration text-[10px] font-medium", product.quantity > 0 ? "text-foreground" : "text-muted-foreground"]}>{product.quantity}</span><span class="flex size-7 items-center justify-center text-xs text-[var(--brand-action)]">+</span>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <aside class="hidden overflow-hidden rounded-lg border border-border-illustration bg-card lg:block">
            <div class="border-b border-border-illustration px-4 py-3"><div class="text-foreground text-[11px] font-semibold">{locale === "en" ? "Order" : "Bestelling"}</div><div class="text-muted-foreground mt-0.5 text-[8px]">{locale === "en" ? "Delivery Friday 15 Aug" : "Levering vrijdag 15 aug."}</div></div>
            <div class="space-y-2.5 px-4 py-3 text-[9px]">
              <div class="flex justify-between"><span class="text-muted-foreground">2 × {locale === "en" ? "Apple juice" : "Appelsap"}</span><span class="text-foreground">€ 56.80</span></div>
              <div class="flex justify-between"><span class="text-muted-foreground">1 × {locale === "en" ? "Buttermilk" : "Karnemelk"}</span><span class="text-foreground">€ 14.10</span></div>
            </div>
            <div class="border-t border-border-illustration px-4 py-3"><div class="flex justify-between text-[10px] font-semibold"><span>{locale === "en" ? "Total" : "Totaal"}</span><span>€ 70.90</span></div><div class="mt-3 flex h-8 items-center justify-center rounded-md bg-[var(--brand-action)] text-[9px] font-semibold text-white shadow-sm">{locale === "en" ? "Place order" : "Bestelling plaatsen"}</div><div class="text-muted-foreground mt-2 text-center text-[8px]">{locale === "en" ? "Order by 16:00 for Friday delivery" : "Voor 16:00 besteld, vrijdag geleverd"}</div></div>
          </aside>
        </div>
      </div>
    </div>
  </div>
</div>
