---
interface Props {
  icon: "globe" | "cloud" | "chart-bar" | "sparkles" | "bot" | "brain" | "layers";
}

const { icon } = Astro.props;

const svgProps = {
  xmlns: "http://www.w3.org/2000/svg",
  width: "24",
  height: "24",
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  "aria-hidden": "true",
} as const;
---

{
  icon === "globe" && (
    <svg {...svgProps} class="lucide lucide-globe">
      <circle cx="12" cy="12" r="10" />
      <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
      <path d="M2 12h20" />
    </svg>
  )
}
{
  icon === "cloud" && (
    <svg {...svgProps} class="lucide lucide-cloud">
      <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
    </svg>
  )
}
{
  icon === "chart-bar" && (
    <svg {...svgProps} class="lucide lucide-chart-bar">
      <path d="M3 3v16a2 2 0 0 0 2 2h16" />
