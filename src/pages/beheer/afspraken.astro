---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";

export const prerender = false;
---

<Layout title="Afsprakenbeheer | Optidigi" description="Privé afsprakenbeheer voor Optidigi." noindex>
  <main class="theme-green scheme-light min-h-screen bg-background text-foreground dark:scheme-dark">
    <header class="border-b border-foreground/10 bg-card/80 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
        <a href="/" aria-label="Naar de website"><Logo class="h-6 dark:invert" /></a>
        <p class="text-xs font-medium text-muted-foreground">Privé beheer</p>
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-6 py-10">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="text-sm font-medium text-muted-foreground">Optidigi</p>
          <h1 class="mt-1 text-3xl font-semibold tracking-tight">Afspraken</h1>
          <p class="mt-2 text-sm text-muted-foreground">Bekijk bevestigde momenten en blokkeer tijden waarop niemand kan boeken.</p>
        </div>
        <button data-refresh type="button" class="inline-flex h-9 cursor-pointer items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-sm transition hover:bg-primary/90">Vernieuwen</button>
      </div>

      <p data-admin-message class="mt-5 min-h-5 text-sm text-muted-foreground" aria-live="polite"></p>

      <section class="mt-4 overflow-hidden rounded-xl bg-card ring-1 ring-border-illustration">
        <div class="border-b border-foreground/10 px-5 py-4">
          <h2 class="font-medium">Komende afspraken</h2>
        </div>
        <div data-appointments class="divide-y divide-foreground/10">
          <p class="px-5 py-8 text-sm text-muted-foreground">Afspraken laden…</p>
        </div>
      </section>

      <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <section class="rounded-xl bg-card p-5 ring-1 ring-border-illustration">
          <h2 class="font-medium">Tijd blokkeren</h2>
          <p class="mt-1 text-sm text-muted-foreground">Blokkeer een afspraak, dagdeel of volledige dag.</p>
          <form data-block-form class="mt-5 grid gap-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="grid gap-1.5 text-xs font-medium">Van<input required name="startAt" type="datetime-local" class="h-10 rounded-md bg-background px-3 text-sm font-normal outline-none ring-1 ring-border-illustration focus:ring-primary/50" /></label>
              <label class="grid gap-1.5 text-xs font-medium">Tot<input required name="endAt" type="datetime-local" class="h-10 rounded-md bg-background px-3 text-sm font-normal outline-none ring-1 ring-border-illustration focus:ring-primary/50" /></label>
            </div>
            <label class="grid gap-1.5 text-xs font-medium">Reden <span class="font-normal text-muted-foreground">(optioneel)</span><input name="reason" placeholder="Bijvoorbeeld: vrije dag" class="h-10 rounded-md bg-background px-3 text-sm font-normal outline-none ring-1 ring-border-illustration focus:ring-primary/50" /></label>
            <button type="submit" class="inline-flex h-10 cursor-pointer items-center justify-center rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground shadow-sm transition hover:bg-primary/90 disabled:cursor-wait disabled:opacity-60">Blokkeren</button>
          </form>
        </section>

        <section class="overflow-hidden rounded-xl bg-card ring-1 ring-border-illustration">
          <div class="border-b border-foreground/10 px-5 py-4">
            <h2 class="font-medium">Geblokkeerde tijden</h2>
          </div>
          <div data-blocks class="divide-y divide-foreground/10">
            <p class="px-5 py-8 text-sm text-muted-foreground">Blokkades laden…</p>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<script>
  type Appointment = {
    id: string; startAt: string; endAt: string; type: string; name: string; email: string;
    company?: string; phone?: string; subject?: string; note?: string; status: string;
  };
  type Block = { id: string; startAt: string; endAt: string; reason?: string };

  const appointmentsNode = document.querySelector<HTMLElement>("[data-appointments]");
  const blocksNode = document.querySelector<HTMLElement>("[data-blocks]");
  const adminMessage = document.querySelector<HTMLElement>("[data-admin-message]");
  const blockForm = document.querySelector<HTMLFormElement>("[data-block-form]");
  const formatDate = new Intl.DateTimeFormat("nl-NL", { timeZone: "Europe/Amsterdam", weekday: "short", day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" });

  function text(value: unknown) { return document.createTextNode(String(value ?? "")); }
  function element<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    return node;
  }
  function detail(label: string, value: unknown) {
    const item = element("p", "text-sm text-muted-foreground");
    const strong = element("strong", "font-medium text-foreground"); strong.append(text(`${label}: `));
    item.append(strong, text(value || "—")); return item;
  }

  function renderAppointments(appointments: Appointment[]) {
    if (!appointmentsNode) return;
    appointmentsNode.replaceChildren();
    const upcoming = appointments.filter((appointment) => new Date(appointment.endAt) >= new Date());
    if (!upcoming.length) {
      const empty = element("p", "px-5 py-8 text-sm text-muted-foreground"); empty.append(text("Geen komende afspraken.")); appointmentsNode.append(empty); return;
    }
    for (const appointment of upcoming) {
      const row = element("article", "grid gap-4 px-5 py-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start");
      const content = element("div");
      const cancelled = appointment.status === "cancelled";
      const heading = element("h3", `font-medium${cancelled ? " text-muted-foreground line-through" : ""}`); heading.append(text(`${formatDate.format(new Date(appointment.startAt))} · ${appointment.name}`));
      const details = element("div", "mt-2 grid gap-1 sm:grid-cols-2");
      details.append(detail("Type", appointment.type === "phone" ? "Telefoon" : "Video"), detail("E-mail", appointment.email), detail("Telefoon", appointment.phone), detail("Bedrijf", appointment.company));
      if (appointment.subject || appointment.note) details.append(detail("Onderwerp", appointment.subject), detail("Opmerking", appointment.note));
      content.append(heading, details);
      const button = element("button", "inline-flex h-9 cursor-pointer items-center justify-center rounded-md px-3 text-xs font-medium ring-1 transition hover:bg-illustration");
      button.type = "button"; button.dataset.appointmentId = appointment.id;
      button.dataset.status = cancelled ? "confirmed" : "cancelled";
      button.append(text(cancelled ? "Opnieuw bevestigen" : "Annuleren en slot openen"));
      row.append(content, button); appointmentsNode.append(row);
    }
  }

  function renderBlocks(blocks: Block[]) {
    if (!blocksNode) return;
    blocksNode.replaceChildren();
    if (!blocks.length) {
      const empty = element("p", "px-5 py-8 text-sm text-muted-foreground"); empty.append(text("Geen toekomstige blokkades.")); blocksNode.append(empty); return;
    }
    for (const block of blocks) {
      const row = element("div", "flex items-start justify-between gap-4 px-5 py-4");
      const content = element("div");
      const dates = element("p", "text-sm font-medium"); dates.append(text(`${formatDate.format(new Date(block.startAt))} – ${formatDate.format(new Date(block.endAt))}`));
      const reason = element("p", "mt-1 text-xs text-muted-foreground"); reason.append(text(block.reason || "Geen reden opgegeven")); content.append(dates, reason);
      const button = element("button", "cursor-pointer text-xs font-medium text-muted-foreground transition hover:text-foreground"); button.type = "button"; button.dataset.blockId = block.id; button.append(text("Verwijderen"));
      row.append(content, button); blocksNode.append(row);
    }
  }

  async function load() {
    if (adminMessage) adminMessage.textContent = "Gegevens vernieuwen…";
    try {
      const [appointmentsResponse, blocksResponse] = await Promise.all([fetch("/api/admin/appointments"), fetch("/api/admin/blocks")]);
      if (!appointmentsResponse.ok || !blocksResponse.ok) throw new Error("load failed");
      const appointmentsData = await appointmentsResponse.json() as { appointments: Appointment[] };
      const blocksData = await blocksResponse.json() as { blocks: Block[] };
      renderAppointments(appointmentsData.appointments); renderBlocks(blocksData.blocks);
      if (adminMessage) adminMessage.textContent = `Bijgewerkt om ${new Intl.DateTimeFormat("nl-NL", { hour: "2-digit", minute: "2-digit" }).format(new Date())}.`;
    } catch {
      if (adminMessage) adminMessage.textContent = "Gegevens laden is mislukt. Vernieuw de pagina of probeer het opnieuw.";
    }
  }

  document.querySelector("[data-refresh]")?.addEventListener("click", () => void load());
  appointmentsNode?.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-appointment-id]"); if (!button) return;
    button.disabled = true;
    try {
      const response = await fetch(`/api/admin/appointments/${encodeURIComponent(button.dataset.appointmentId || "")}`, { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ status: button.dataset.status }) });
      if (!response.ok) throw new Error("update failed"); await load();
    } catch { if (adminMessage) adminMessage.textContent = "De afspraak aanpassen is mislukt."; button.disabled = false; }
  });
  blocksNode?.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-block-id]"); if (!button) return;
    button.disabled = true;
    try {
      const response = await fetch(`/api/admin/blocks/${encodeURIComponent(button.dataset.blockId || "")}`, { method: "DELETE" });
      if (!response.ok) throw new Error("delete failed"); await load();
    } catch { if (adminMessage) adminMessage.textContent = "De blokkade verwijderen is mislukt."; button.disabled = false; }
  });
  blockForm?.addEventListener("submit", async (event) => {
    event.preventDefault(); const submit = blockForm.querySelector<HTMLButtonElement>("button[type=submit]"); if (submit) submit.disabled = true;
    const fields = new FormData(blockForm); const start = new Date(String(fields.get("startAt"))); const end = new Date(String(fields.get("endAt")));
    if (!Number.isFinite(start.getTime()) || !Number.isFinite(end.getTime()) || end <= start) {
      if (adminMessage) adminMessage.textContent = "Kies een eindtijd die na de begintijd ligt."; if (submit) submit.disabled = false; return;
    }
    try {
      const response = await fetch("/api/admin/blocks", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ startAt: start.toISOString(), endAt: end.toISOString(), reason: String(fields.get("reason") || "").trim() }) });
      if (!response.ok) throw new Error("create failed"); blockForm.reset(); await load();
    } catch { if (adminMessage) adminMessage.textContent = "De blokkade opslaan is mislukt."; }
    finally { if (submit) submit.disabled = false; }
  });

  void load();
</script>
