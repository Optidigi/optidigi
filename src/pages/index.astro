---
import SiteHomepage from "@/components/pages/SiteHomepage.astro";
import { cmsOrigin, fetchHomepageContent } from "@/lib/server/cms";

export const prerender = false;

const origin = cmsOrigin();
const content = origin ? await fetchHomepageContent(origin) : undefined;
if (origin) Astro.response.headers.set("cache-control", "no-store");
---

<SiteHomepage content={content} />
