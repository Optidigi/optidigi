---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import HomePage from "@/components/HomePage.astro";
import { siteConfig } from "@/config/site";

export const prerender = false;
---

<Layout title={siteConfig.defaultTitle} description={siteConfig.description} canonicalPath="/">
  <div
    class="theme-green scheme-light selection:bg-primary/15 selection:text-foreground bg-background dark:scheme-dark"
  >
  <SiteHeader locale="nl" />
  <HomePage locale="nl" />
  </div>
</Layout>
