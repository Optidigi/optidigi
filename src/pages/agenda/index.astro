---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";

export const prerender = false;
---

<Layout title="Agenda | Optidigi" description="Beheer afspraken en beschikbaarheid van Optidigi." noindex>
  <main class="theme-green scheme-light min-h-screen bg-background text-foreground dark:scheme-dark">
    <header class="sticky top-0 z-20 border-b border-foreground/10 bg-background/90 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
        <div class="flex items-center gap-4">
          <a href="/" aria-label="Naar de website"><Logo class="h-6 dark:invert" /></a>
          <span class="h-5 w-px bg-foreground/15" aria-hidden="true"></span>
          <span class="text-sm font-semibold">Agenda</span>
        </div>
        <button data-logout type="button" class="cursor-pointer rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition hover:bg-illustration hover:text-foreground">Uitloggen</button>
      </div>
    </header>

    <div class="mx-auto max-w-7xl px-5 py-8 sm:px-8 sm:py-10">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
          <p class="text-sm font-medium text-muted-foreground">Afsprakenbeheer</p>
          <h1 class="mt-1 text-3xl font-semibold tracking-tight sm:text-4xl">Overzicht en beschikbaarheid</h1>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted-foreground">Bekijk wie een gesprek heeft gepland, annuleer een afspraak of sluit momenten uit voor nieuwe boekingen.</p>
        </div>
        <button data-refresh type="button" class="inline-flex h-10 cursor-pointer items-center justify-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition hover:bg-primary/90">Gegevens vernieuwen</button>
      </div>

      <p data-admin-message class="mt-5 min-h-5 text-sm text-muted-foreground" aria-live="polite"></p>

      <section class="mt-2 grid gap-3 sm:grid-cols-3" aria-label="Samenvatting">
        <article class="rounded-xl bg-card p-5 ring-1 ring-border-illustration">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Komende afspraken</p>
          <p data-count-upcoming class="mt-2 text-3xl font-semibold tabular-nums">—</p>
          <p class="mt-1 text-xs text-muted-foreground">Bevestigd en nog te voeren</p>
        </article>
        <article class="rounded-xl bg-card p-5 ring-1 ring-border-illustration">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Geannuleerd</p>
          <p data-count-cancelled class="mt-2 text-3xl font-semibold tabular-nums">—</p>
          <p class="mt-1 text-xs text-muted-foreground">Bewaard in de administratie</p>
        </article>
        <article class="rounded-xl bg-card p-5 ring-1 ring-border-illustration">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Geblokkeerde perioden</p>
          <p data-count-blocks class="mt-2 text-3xl font-semibold tabular-nums">—</p>
          <p class="mt-1 text-xs text-muted-foreground">Niet boekbaar voor klanten</p>
        </article>
      </section>

      <section class="mt-7 overflow-hidden rounded-xl bg-card ring-1 ring-border-illustration" aria-labelledby="appointments-title">
        <div class="flex flex-col gap-3 border-b border-foreground/10 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 id="appointments-title" class="font-semibold">Afspraken</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Een annulering maakt het tijdstip direct opnieuw boekbaar.</p>
          </div>
          <label class="flex items-center gap-2 text-xs font-medium text-muted-foreground">
            Tonen
            <select data-appointment-filter class="h-9 cursor-pointer rounded-lg bg-background px-3 text-sm text-foreground outline-none ring-1 ring-border-illustration focus:ring-2 focus:ring-primary/25">
              <option value="upcoming">Komende afspraken</option>
              <option value="cancelled">Geannuleerde afspraken</option>
              <option value="past">Afgelopen afspraken</option>
              <option value="all">Alle afspraken</option>
            </select>
          </label>
        </div>
        <div data-appointments class="divide-y divide-foreground/10">
          <p class="px-5 py-10 text-sm text-muted-foreground">Afspraken laden…</p>
        </div>
      </section>

      <div class="mt-7 grid gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <section class="rounded-xl bg-card p-5 ring-1 ring-border-illustration" aria-labelledby="block-title">
          <h2 id="block-title" class="font-semibold">Beschikbaarheid blokkeren</h2>
          <p class="mt-1 text-sm text-muted-foreground">Voorkom nieuwe boekingen tijdens een afspraak, dagdeel of vrije dag.</p>
          <form data-block-form class="mt-5 grid gap-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="grid gap-1.5 text-xs font-semibold">Begint op<input required name="startAt" type="datetime-local" class="h-10 rounded-lg bg-background px-3 text-sm font-normal outline-none ring-1 ring-border-illustration focus:ring-2 focus:ring-primary/25" /></label>
              <label class="grid gap-1.5 text-xs font-semibold">Eindigt op<input required name="endAt" type="datetime-local" class="h-10 rounded-lg bg-background px-3 text-sm font-normal outline-none ring-1 ring-border-illustration focus:ring-2 focus:ring-primary/25" /></label>
            </div>
            <label class="grid gap-1.5 text-xs font-semibold">Reden <span class="sr-only">optioneel</span><input name="reason" placeholder="Bijvoorbeeld: vrije dag (optioneel)" class="h-10 rounded-lg bg-background px-3 text-sm font-normal outline-none ring-1 ring-border-illustration focus:ring-2 focus:ring-primary/25" /></label>
            <button type="submit" class="inline-flex h-10 cursor-pointer items-center justify-center rounded-lg bg-primary px-5 text-sm font-semibold text-primary-foreground shadow-sm transition hover:bg-primary/90 disabled:cursor-wait disabled:opacity-60">Periode blokkeren</button>
          </form>
        </section>

        <section class="overflow-hidden rounded-xl bg-card ring-1 ring-border-illustration" aria-labelledby="blocks-title">
          <div class="border-b border-foreground/10 px-5 py-4">
            <h2 id="blocks-title" class="font-semibold">Niet-beschikbare perioden</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Deze perioden worden niet aangeboden aan klanten.</p>
          </div>
          <div data-blocks class="divide-y divide-foreground/10">
            <p class="px-5 py-10 text-sm text-muted-foreground">Geblokkeerde perioden laden…</p>
          </div>
        </section>
      </div>
    </div>
  </main>

  <dialog data-delete-dialog aria-labelledby="delete-dialog-title" class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl bg-card p-0 text-foreground shadow-2xl backdrop:bg-black/50">
    <form method="dialog" class="p-6">
      <p class="text-xs font-semibold uppercase tracking-wide text-destructive">Definitief verwijderen</p>
      <h2 id="delete-dialog-title" class="mt-2 text-xl font-semibold">Afspraak volledig verwijderen?</h2>
      <p data-delete-description class="mt-3 text-sm leading-relaxed text-muted-foreground"></p>
      <p class="mt-3 rounded-lg bg-destructive/10 px-3.5 py-3 text-sm text-destructive">Dit verwijdert ook de gekoppelde e-mailadministratie. Deze actie kan niet ongedaan worden gemaakt.</p>
      <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <button value="cancel" class="h-10 cursor-pointer rounded-lg px-4 text-sm font-semibold ring-1 ring-border-illustration transition hover:bg-illustration">Niet verwijderen</button>
        <button data-confirm-delete value="default" class="h-10 cursor-pointer rounded-lg bg-destructive px-4 text-sm font-semibold text-white transition hover:opacity-90">Definitief verwijderen</button>
      </div>
    </form>
  </dialog>
</Layout>

<script>
  type Appointment = {
    id: string; startAt: string; endAt: string; type: string; name: string; email: string;
    company?: string; phone?: string; subject?: string; note?: string; status: "confirmed" | "cancelled";
  };
  type Block = { id: string; startAt: string; endAt: string; reason?: string };

  const appointmentsNode = document.querySelector<HTMLElement>("[data-appointments]");
  const blocksNode = document.querySelector<HTMLElement>("[data-blocks]");
  const adminMessage = document.querySelector<HTMLElement>("[data-admin-message]");
  const blockForm = document.querySelector<HTMLFormElement>("[data-block-form]");
  const filter = document.querySelector<HTMLSelectElement>("[data-appointment-filter]");
  const deleteDialog = document.querySelector<HTMLDialogElement>("[data-delete-dialog]");
  const deleteDescription = document.querySelector<HTMLElement>("[data-delete-description]");
  const confirmDelete = document.querySelector<HTMLButtonElement>("[data-confirm-delete]");
  const dateTime = new Intl.DateTimeFormat("nl-NL", { timeZone: "Europe/Amsterdam", weekday: "long", day: "numeric", month: "long", year: "numeric", hour: "2-digit", minute: "2-digit" });
  const time = new Intl.DateTimeFormat("nl-NL", { timeZone: "Europe/Amsterdam", hour: "2-digit", minute: "2-digit" });
  let allAppointments: Appointment[] = [];
  let appointmentToDelete: Appointment | null = null;

  function text(value: unknown) { return document.createTextNode(String(value ?? "")); }
  function element<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string) {
    const node = document.createElement(tag); if (className) node.className = className; return node;
  }
  function detail(label: string, value: unknown, href?: string) {
    const item = element("div", "min-w-0");
    const term = element("dt", "text-[11px] font-semibold uppercase tracking-wide text-muted-foreground"); term.append(text(label));
    const description = element("dd", "mt-0.5 break-words text-sm");
    if (href && value) { const link = element("a", "hover:underline"); link.href = href; link.append(text(value)); description.append(link); }
    else description.append(text(value || "Niet opgegeven"));
    item.append(term, description); return item;
  }
  function setMessage(value: string, error = false) {
    if (!adminMessage) return; adminMessage.textContent = value; adminMessage.classList.toggle("text-destructive", error); adminMessage.classList.toggle("text-muted-foreground", !error);
  }
  function redirectOnUnauthorized(response: Response) {
    if (response.status === 401) { window.location.assign("/agenda/login"); return true; }
    return false;
  }

  function selectedAppointments() {
    const now = Date.now();
    switch (filter?.value) {
      case "cancelled": return allAppointments.filter((item) => item.status === "cancelled");
      case "past": return allAppointments.filter((item) => item.status === "confirmed" && new Date(item.endAt).getTime() < now);
      case "all": return allAppointments;
      default: return allAppointments.filter((item) => item.status === "confirmed" && new Date(item.endAt).getTime() >= now);
    }
  }

  function renderAppointments() {
    if (!appointmentsNode) return;
    appointmentsNode.replaceChildren();
    const appointments = selectedAppointments();
    if (!appointments.length) {
      const empty = element("p", "px-5 py-10 text-sm text-muted-foreground"); empty.append(text("Geen afspraken in deze weergave.")); appointmentsNode.append(empty); return;
    }
    for (const appointment of appointments) {
      const cancelled = appointment.status === "cancelled";
      const row = element("article", "grid gap-5 px-5 py-5 xl:grid-cols-[minmax(0,1fr)_auto] xl:items-start");
      const content = element("div", "min-w-0");
      const top = element("div", "flex flex-wrap items-center gap-2");
      const heading = element("h3", "font-semibold"); heading.append(text(appointment.name));
      const badge = element("span", cancelled ? "rounded-full bg-muted px-2 py-1 text-[11px] font-semibold text-muted-foreground" : "rounded-full bg-emerald-500/10 px-2 py-1 text-[11px] font-semibold text-emerald-700 dark:text-emerald-300"); badge.append(text(cancelled ? "Geannuleerd" : "Bevestigd"));
      top.append(heading, badge);
      const date = element("p", "mt-1 text-sm font-medium"); date.append(text(`${dateTime.format(new Date(appointment.startAt))} – ${time.format(new Date(appointment.endAt))}`));
      const details = element("dl", "mt-4 grid gap-x-5 gap-y-3 sm:grid-cols-2 lg:grid-cols-4");
      details.append(
        detail("Gesprek", appointment.type === "phone" ? "Telefonisch" : "Videogesprek"),
        detail("E-mail", appointment.email, `mailto:${appointment.email}`),
        detail("Telefoon", appointment.phone, appointment.phone ? `tel:${appointment.phone.replace(/\s/g, "")}` : undefined),
        detail("Bedrijf", appointment.company),
        detail("Onderwerp", appointment.subject),
        detail("Opmerking", appointment.note),
      );
      content.append(top, date, details);

      const actions = element("div", "flex flex-wrap gap-2 xl:max-w-56 xl:justify-end");
      const statusButton = element("button", cancelled ? "h-9 cursor-pointer rounded-lg px-3 text-xs font-semibold ring-1 ring-border-illustration transition hover:bg-illustration" : "h-9 cursor-pointer rounded-lg px-3 text-xs font-semibold text-destructive ring-1 ring-destructive/25 transition hover:bg-destructive/10");
      statusButton.type = "button"; statusButton.dataset.appointmentStatus = cancelled ? "confirmed" : "cancelled"; statusButton.dataset.appointmentId = appointment.id; statusButton.append(text(cancelled ? "Opnieuw bevestigen" : "Afspraak annuleren"));
      const deleteButton = element("button", "h-9 cursor-pointer rounded-lg px-3 text-xs font-semibold text-muted-foreground transition hover:bg-destructive/10 hover:text-destructive");
      deleteButton.type = "button"; deleteButton.dataset.deleteAppointment = appointment.id; deleteButton.append(text("Definitief verwijderen"));
      actions.append(statusButton, deleteButton);
      row.append(content, actions); appointmentsNode.append(row);
    }
  }

  function renderBlocks(blocks: Block[]) {
    if (!blocksNode) return;
    blocksNode.replaceChildren();
    if (!blocks.length) { const empty = element("p", "px-5 py-10 text-sm text-muted-foreground"); empty.append(text("Er zijn geen toekomstige geblokkeerde perioden.")); blocksNode.append(empty); return; }
    for (const block of blocks) {
      const row = element("div", "flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-start sm:justify-between");
      const content = element("div");
      const dates = element("p", "text-sm font-semibold"); dates.append(text(`${dateTime.format(new Date(block.startAt))} – ${dateTime.format(new Date(block.endAt))}`));
      const reason = element("p", "mt-1 text-xs text-muted-foreground"); reason.append(text(block.reason || "Geen reden opgegeven")); content.append(dates, reason);
      const button = element("button", "w-fit cursor-pointer rounded-lg px-3 py-2 text-xs font-semibold text-muted-foreground transition hover:bg-destructive/10 hover:text-destructive"); button.type = "button"; button.dataset.blockId = block.id; button.append(text("Blokkering verwijderen"));
      row.append(content, button); blocksNode.append(row);
    }
  }

  async function load() {
    setMessage("Gegevens worden bijgewerkt…");
    try {
      const [appointmentsResponse, blocksResponse] = await Promise.all([fetch("/api/admin/appointments"), fetch("/api/admin/blocks")]);
      if (redirectOnUnauthorized(appointmentsResponse) || redirectOnUnauthorized(blocksResponse)) return;
      if (!appointmentsResponse.ok || !blocksResponse.ok) throw new Error("load failed");
      const appointmentsData = await appointmentsResponse.json() as { appointments: Appointment[] };
      const blocksData = await blocksResponse.json() as { blocks: Block[] };
      allAppointments = appointmentsData.appointments;
      const now = Date.now();
      const upcoming = allAppointments.filter((item) => item.status === "confirmed" && new Date(item.endAt).getTime() >= now).length;
      const cancelled = allAppointments.filter((item) => item.status === "cancelled").length;
      document.querySelector<HTMLElement>("[data-count-upcoming]")!.textContent = String(upcoming);
      document.querySelector<HTMLElement>("[data-count-cancelled]")!.textContent = String(cancelled);
      document.querySelector<HTMLElement>("[data-count-blocks]")!.textContent = String(blocksData.blocks.length);
      renderAppointments(); renderBlocks(blocksData.blocks);
      setMessage(`Bijgewerkt om ${time.format(new Date())}.`);
    } catch { setMessage("De gegevens konden niet worden geladen. Probeer het opnieuw.", true); }
  }

  filter?.addEventListener("change", renderAppointments);
  document.querySelector("[data-refresh]")?.addEventListener("click", () => void load());
  appointmentsNode?.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement;
    const statusButton = target.closest<HTMLButtonElement>("[data-appointment-status]");
    const deleteButton = target.closest<HTMLButtonElement>("[data-delete-appointment]");
    if (deleteButton) {
      appointmentToDelete = allAppointments.find((item) => item.id === deleteButton.dataset.deleteAppointment) || null;
      if (appointmentToDelete && deleteDialog && deleteDescription) {
        deleteDescription.textContent = `${appointmentToDelete.name} · ${dateTime.format(new Date(appointmentToDelete.startAt))}`;
        deleteDialog.showModal();
      }
      return;
    }
    if (!statusButton) return;
    statusButton.disabled = true;
    try {
      const response = await fetch(`/api/admin/appointments/${encodeURIComponent(statusButton.dataset.appointmentId || "")}`, { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ status: statusButton.dataset.appointmentStatus }) });
      if (redirectOnUnauthorized(response)) return;
      if (!response.ok) { const result = await response.json().catch(() => null) as { message?: string } | null; throw new Error(result?.message || "Aanpassen is mislukt."); }
      await load();
    } catch (error) { setMessage(error instanceof Error ? error.message : "De afspraak kon niet worden aangepast.", true); statusButton.disabled = false; }
  });

  confirmDelete?.addEventListener("click", async (event) => {
    event.preventDefault();
    if (!appointmentToDelete || !confirmDelete) return;
    confirmDelete.disabled = true; confirmDelete.textContent = "Verwijderen…";
    try {
      const response = await fetch(`/api/admin/appointments/${encodeURIComponent(appointmentToDelete.id)}`, { method: "DELETE" });
      if (redirectOnUnauthorized(response)) return;
      if (!response.ok) throw new Error("Verwijderen is mislukt.");
      deleteDialog?.close(); appointmentToDelete = null; await load(); setMessage("De afspraak is definitief verwijderd.");
    } catch (error) { setMessage(error instanceof Error ? error.message : "De afspraak kon niet worden verwijderd.", true); }
    finally { confirmDelete.disabled = false; confirmDelete.textContent = "Definitief verwijderen"; }
  });

  blocksNode?.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-block-id]"); if (!button) return;
    button.disabled = true;
    try {
      const response = await fetch(`/api/admin/blocks/${encodeURIComponent(button.dataset.blockId || "")}`, { method: "DELETE" });
      if (redirectOnUnauthorized(response)) return;
      if (!response.ok) throw new Error("delete failed"); await load();
    } catch { setMessage("De blokkering kon niet worden verwijderd.", true); button.disabled = false; }
  });

  blockForm?.addEventListener("submit", async (event) => {
    event.preventDefault(); const submit = blockForm.querySelector<HTMLButtonElement>('button[type="submit"]'); if (submit) submit.disabled = true;
    const fields = new FormData(blockForm); const start = new Date(String(fields.get("startAt"))); const end = new Date(String(fields.get("endAt")));
    if (!Number.isFinite(start.getTime()) || !Number.isFinite(end.getTime()) || end <= start) { setMessage("De eindtijd moet na de begintijd liggen.", true); if (submit) submit.disabled = false; return; }
    try {
      const response = await fetch("/api/admin/blocks", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ startAt: start.toISOString(), endAt: end.toISOString(), reason: String(fields.get("reason") || "").trim() }) });
      if (redirectOnUnauthorized(response)) return;
      if (!response.ok) throw new Error("create failed"); blockForm.reset(); await load();
    } catch { setMessage("De geblokkeerde periode kon niet worden opgeslagen.", true); }
    finally { if (submit) submit.disabled = false; }
  });

  document.querySelector("[data-logout]")?.addEventListener("click", async () => {
    await fetch("/api/admin/session", { method: "DELETE", headers: { "Content-Type": "application/json" } }).catch(() => null);
    window.location.assign("/agenda/login");
  });

  void load();
</script>
