---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
import AgendaDashboard from "@/components/admin/AgendaDashboard";

export const prerender = false;
---

<Layout title="Agenda | Optidigi" description="Beheer afspraken en beschikbaarheid van Optidigi." noindex>
  <script is:inline>
    (() => {
      const saved = localStorage.getItem("optidigi-agenda-theme");
      const dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", dark);
      document.documentElement.style.colorScheme = dark ? "dark" : "light";
    })();
  </script>
  <main id="main-content" class="theme-green scheme-light min-h-screen bg-background text-foreground dark:scheme-dark">
    <header class="sticky top-0 z-30 border-b border-foreground/10 bg-background/90 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
        <div class="flex items-center gap-4">
          <a href="/" aria-label="Naar de website"><Logo class="h-6 dark:invert" /></a>
          <span class="h-5 w-px bg-foreground/15" aria-hidden="true"></span>
          <span class="text-sm font-semibold">Agenda</span>
        </div>
        <button data-logout type="button" class="inline-flex cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition hover:bg-illustration hover:text-foreground">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" x2="9" y1="12" y2="12"></line></svg>
          Uitloggen
        </button>
      </div>
    </header>
    <AgendaDashboard client:load />
  </main>
</Layout>

<script>
  document.querySelector("[data-logout]")?.addEventListener("click", async () => {
    await fetch("/api/admin/session", { method: "DELETE", headers: { "Content-Type": "application/json" } }).catch(() => null);
    window.location.assign("/agenda/login");
  });
</script>
