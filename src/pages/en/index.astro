---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import HomePage from "@/components/HomePage.astro";
import { getSiteConfig } from "@/config/site";
const site = getSiteConfig("en");
---

<Layout locale="en" title={site.defaultTitle} description={site.description} canonicalPath="/en/">
  <div class="theme-green scheme-light selection:bg-primary/15 selection:text-foreground bg-background dark:scheme-dark">
    <SiteHeader locale="en" />
    <HomePage locale="en" />
  </div>
</Layout>
